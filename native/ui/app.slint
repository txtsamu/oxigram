// Oxigram's native window. All state lives in Rust (src/main.rs); this file
// only lays it out. Sizes and colors follow the dark theme of the WebView
// build (src/app.css, views/DialogList.svelte, views/Chat.svelte).

import { ScrollView, ListView } from "std-widgets.slint";
import "../fonts/OpenSans-Regular.ttf";
import "../fonts/OpenSans-SemiBold.ttf";
// Colour country flags (Twemoji, CC-BY 4.0): Windows' emoji font has none.
import "../fonts/OxigramFlags.ttf";

export struct MenuEntry {
    id: string,
    label: string,
    icon: string,
    danger: bool,
}

// One file in the send window.
export struct SendItem {
    name: string,
    size: string,
    thumb: image,
    has-thumb: bool,
}

export struct SaverOption {
    key: string,
    title: string,
    note: string,
    on: bool,
    // The settings page it is on: "notifications", "data" or "general"
    group: string,
    // Lines the note takes in the settings column (fixed heights)
    note-lines: int,
}

// A country of the phone login's list.
export struct CountryItem {
    flag: string,
    name: string,
    // "+7"
    dial: string,
}

// An inline button under a message, and a row of them.
export struct KeyButton {
    text: string,
    // Opens an address (marked with an arrow)
    link: bool,
    row: int,
    col: int,
}

export struct ButtonRow {
    items: [KeyButton],
}

export struct TopicItem {
    id: int,
    title: string,
    unread: int,
    pinned: bool,
    closed: bool,
    color: color,
}

export struct DialogItem {
    title: string,
    initial: string,
    color: color,
    photo: image,
    has-photo: bool,
    preview: string,
    // "Вы: " before the preview (groups and channels)
    you: bool,
    time: string,
    unread: int,
    muted: bool,
    pinned: bool,
    online: bool,
    // 0: none, 1: sent, 2: read
    ticks: int,
    saved: bool,
    active: bool,
    // "user", "group", "channel", "saved": decides the menu's wording
    kind: string,
    archived: bool,
    // the row shows "печатает…" instead of the last message
    typing: bool,
    // the preview is an unsent draft (shown after "Черновик: ")
    draft: bool,
}

// One hit of the search inside a chat.
export struct SearchHit {
    who: string,
    text: string,
    date: string,
}

// A chat folder tab above the list.
export struct FolderTab {
    title: string,
    unread: int,
    on: bool,
}

// One row of the contacts window.
export struct ContactItem {
    title: string,
    status: string,
    online: bool,
    initial: string,
    color: color,
    photo: image,
    has-photo: bool,
}

// One line of the profile column. `value` may wrap; the label is one line.
export struct ProfileLine {
    value: string,
    label: string,
}

// One picture inside a bubble (a whole single picture, or an album cell).
// Geometry is in logical pixels at the natural size; the bubble scales it.
export struct MediaCell {
    id: int,
    x: length,
    y: length,
    w: length,
    h: length,
    image: image,
    // 0 waiting, 1 loading, 2 ready, 3 failed, 4 waits for a click
    state: int,
    // "1:05" or "GIF", top left
    badge: string,
    play: bool,
    // Rounded corners: top-left, top-right, bottom-left, bottom-right
    tl: bool,
    tr: bool,
    bl: bool,
    br: bool,
}

// One reaction under a message.
export struct ReactionChip {
    // The message it belongs to (an album's part that carries them)
    message: int,
    // "👍", "custom:<id>", "paid", or "" for the folded custom ones
    key: string,
    // Document ID of a custom emoji, to fetch its picture
    custom: string,
    text: string,
    image: image,
    has-image: bool,
    count: int,
    mine: bool,
    // Paid and folded reactions cannot be clicked
    enabled: bool,
}

// Slint has no wrapping layout: chips come in rows of four.
export struct ReactionRow {
    chips: [ReactionChip],
}

// A file attached to a message (a document), drawn as a card in the bubble.
export struct FileItem {
    // Message id of the file (an album of files has one per file)
    id: int,
    name: string,
    // "PDF", "ZIP"…: shown in the circle once downloaded
    ext: string,
    // "1,2 МБ", or "0,4 МБ из 1,2 МБ" while downloading
    size: string,
    // 0 not downloaded, 1 downloading, 2 downloaded
    state: int,
    progress: float,
}

export struct MessageItem {
    id: int,
    text: string,
    // "Фото", "Видео"… for content not drawn yet
    media: string,
    time: string,
    outgoing: bool,
    ticks: int,
    // Shown above the first message of a run in groups
    sender: string,
    sender-color: color,
    service: bool,
    // A date pill above the message when it starts a new day
    day: string,
    edited: bool,
    // Continues the run of the message above (smaller gap)
    joined: bool,
    // Last of its run: the corner next to the sender gets the "tail"
    tail: bool,
    // Has line breaks, so the time cannot sit at the end of a single line
    multiline: bool,
    // Own text message: "Изменить" in its menu
    can-edit: bool,
    // The post in Telegram, for what Oxigram cannot draw (`media` says what)
    media-link: string,
    // Inline buttons (bots, channels)
    buttons: [ButtonRow],
    // A channel post's comments ("12 comments"); empty when there are none
    comments-text: string,
    // Pictures: one, or an album grid
    cells: [MediaCell],
    media-w: length,
    media-h: length,
    // Pictures without caption: the time sits on the picture
    media-only: bool,
    // No bubble behind it
    sticker: bool,
    round: bool,
    // A later message of an album: drawn by the album's first row
    hidden: bool,
    // Channel posts: every bubble as wide as the column allows
    wide: bool,
    reactions: [ReactionRow],
    // Picked in selection mode
    selected: bool,
    // Voice (1) or audio file (2) with a player row; 0 for anything else
    track: int,
    track-title: string,
    track-total: string,
    // Waveform of a voice message as an SVG path in a 180x26 box
    wave: string,
    // Files (documents) of the message or of its album
    files: [FileItem],
    // The text with clickable links (see links.rs); `linked` picks it
    rich: styled-text,
    linked: bool,
    // A reply: who wrote the answered message and a line of it
    reply: bool,
    reply-who: string,
    reply-text: string,
}

// What plays now; the state lives in Rust (rows are recreated while scrolling).
export global Player {
    // Message id of the track in the open chat, -1 when none
    in property <int> shown: -1;
    // 0 idle, 1 downloading, 2 playing, 3 paused
    in property <int> state: 0;
    in property <float> progress: 0;
    in property <string> elapsed;
    callback toggle(int);
    callback seek(int, float);
}

// Colours of the dark and the light look (the light one as in the WebView
// build), and the message text scale. Rust sets `light` and `scale` from the
// settings at start and when they change.
export global Theme {
    in-out property <bool> light: false;
    // "Размер текста": 0.9 small, 1 normal, 1.12 large
    in-out property <float> scale: 1;
    out property <color> bg: root.light ? #ffffff : #0e1621;
    out property <color> raised: root.light ? #ffffff : #17212b;
    out property <color> input: root.light ? #f1f3f5 : #242f3d;
    out property <color> hover: root.light ? #f1f3f5 : #202b36;
    out property <color> active: root.light ? #3e88f7 : #2b5278;
    // Text on the selected chat
    out property <color> active-text: root.light ? #ffffff : #f5f5f5;
    out property <color> border: root.light ? #e3e6ea : #0f1923;
    out property <color> text: root.light ? #0f1419 : #f5f5f5;
    // Text on an outgoing bubble (blue in both looks)
    out property <color> text-out: root.light ? #ffffff : #f5f5f5;
    out property <color> dim: root.light ? #707a85 : #7f91a4;
    out property <color> accent: root.light ? #3390ec : #5ea5e8;
    out property <color> accent-text: root.light ? #ffffff : #06121f;
    out property <color> danger: root.light ? #e53935 : #ff6b6b;
    out property <color> bubble-in: root.light ? #ffffff : #182533;
    out property <color> bubble-out: root.light ? #3d8ee6 : #2b5278;
    out property <color> pill: root.light ? #3c5a7852 : #0e1621b8;
    out property <color> read-tick: root.light ? #ffffff : #6ec6ff;
    // Menus and toasts
    out property <color> menu: root.light ? #ffffff : #1f2c3a;
    // The chat background: a vertical gradient under the doodle pattern
    out property <color> chat-top: root.light ? #cfe3f5 : #0e1621;
    out property <color> chat-bottom: root.light ? #d7ead9 : #0b121a;
    // The pattern is drawn in white; the light look tints it dark blue.
    out property <color> pattern-tint: root.light ? #305070 : transparent;
    out property <length> column: 820px;
}

// SVG-like icons: a path in a 24×24 box.
component Icon inherits Path {
    in property <length> size: 20px;
    in property <color> tint: Theme.dim;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: self.tint;
}

component StrokeIcon inherits Path {
    in property <length> size: 20px;
    in property <color> tint: Theme.dim;
    width: self.size;
    height: self.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: self.tint;
    stroke-width: 1.8px;
    fill: transparent;
}

// One or two check marks (viewBox 18×12, as in the WebView build).
component Ticks inherits Rectangle {
    in property <int> count;
    in property <color> tint: Theme.accent;
    width: 16px;
    height: 11px;
    Path {
        width: 16px;
        height: 11px;
        viewbox-width: 18;
        viewbox-height: 12;
        stroke: root.tint;
        stroke-width: 1.6px;
        commands: root.count > 1 ? "M1.5 6.5 5 10l6.5-8M8 10l6.5-8" : "M1.5 6.5 5 10l6.5-8";
    }
}

component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <image> photo;
    in property <bool> has-photo;
    in property <bool> saved;
    in property <length> size: 48px;
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    clip: true;
    // A photo comes already cut to a circle (see `circle` in main.rs).
    background: root.saved ? #4c9ffe : root.has-photo ? transparent : root.tint;
    if !root.saved && !root.has-photo: Text {
        text: root.initial;
        color: white;
        font-size: root.size * 0.4;
        font-weight: 600;
    }
    if root.saved: Icon {
        size: root.size * 0.5;
        tint: white;
        commands: "M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z";
    }
    if root.has-photo && !root.saved: Image {
        source: root.photo;
        width: root.size;
        height: root.size;
        image-fit: cover;
    }
}

// A text field drawn like the WebView's inputs.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback accepted(string);
    callback edited(string);
    public function grab-focus() {
        input.focus();
    }
    // Replaces the text and puts the cursor after it (`bytes` = its UTF-8 length).
    public function set-text-end(text: string, bytes: int) {
        input.text = text;
        input.set-selection-offsets(bytes, bytes);
    }
    height: 40px;
    border-radius: 8px;
    background: Theme.input;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    if input.text == "": Text {
        x: 12px;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 15px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 15px;
        enabled: root.enabled;
        input-type: root.password ? InputType.password : InputType.text;
        single-line: true;
        selection-background-color: #4a7bb7;
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            root.edited(self.text);
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // "primary", "ghost" or "link"
    in property <string> kind: "primary";
    callback clicked();
    height: root.kind == "link" ? 24px : 40px;
    border-radius: 8px;
    background: root.kind != "primary" ? transparent : touch.has-hover && root.enabled ? #74b3ee : Theme.accent;
    border-width: root.kind == "ghost" ? 1px : 0;
    border-color: #2a3949;
    opacity: root.enabled ? 1 : 0.5;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    Text {
        text: root.text;
        color: root.kind == "primary" ? Theme.accent-text : root.kind == "link" ? Theme.accent : Theme.text;
        font-size: 15px;
        font-weight: root.kind == "primary" ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Badge inherits Rectangle {
    in property <int> count;
    in property <bool> quiet;
    in property <bool> on-active;
    height: 22px;
    min-width: 22px;
    border-radius: 11px;
    background: root.on-active ? white : root.quiet ? Theme.dim : Theme.accent;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        Text {
            text: root.count > 999 ? "999+" : root.count;
            color: root.on-active ? Theme.active : white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component DialogRow inherits Rectangle {
    in property <DialogItem> item;
    callback clicked();
    callback context(length, length);
    height: 66px;
    background: root.item.active ? Theme.active : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    property <color> soft: root.item.active ? #ffffffbf : Theme.dim;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                Avatar {
                    initial: root.item.initial;
                    tint: root.item.color;
                    photo: root.item.photo;
                    has-photo: root.item.has-photo;
                    saved: root.item.saved;
                }

                if root.item.online: Rectangle {
                    x: parent.width - 13px;
                    y: parent.height - 13px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: root.item.active ? Theme.active : touch.has-hover ? Theme.hover : Theme.raised;
                    background: #4fce5d;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.title;
                    color: root.item.active ? Theme.active-text : Theme.text;
                    font-weight: 600;
                    font-size: 15px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.item.muted: VerticalLayout {
                    alignment: center;
                    StrokeIcon {
                        size: 14px;
                        stroke-width: 2px;
                        tint: root.soft;
                        commands: "M11 5 6 9H3v6h3l5 4V5zM16 9l5 6M21 9l-5 6";
                    }
                }
                if root.item.ticks > 0: VerticalLayout {
                    alignment: center;
                    Ticks {
                        count: root.item.ticks;
                        tint: root.item.active ? white : Theme.accent;
                    }
                }
                Text {
                    text: root.item.time;
                    color: root.soft;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;
                    if root.item.draft: Text {
                        text: @tr("Draft: ");
                        color: root.item.active ? white : Theme.danger;
                        font-size: 15px;
                    }
                    Text {
                        text: (root.item.you ? @tr("You: ") : "") + root.item.preview;
                        color: root.item.typing && !root.item.active ? Theme.accent : root.soft;
                        font-size: 15px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                if root.item.unread > 0: Badge {
                    count: root.item.unread;
                    quiet: root.item.muted;
                    on-active: root.item.active;
                }
                if root.item.unread == 0 && root.item.pinned: VerticalLayout {
                    alignment: center;
                    Icon {
                        size: 14px;
                        tint: root.soft;
                        commands: "M14 3l7 7-3 1-3 3 .5 4.5L14 20l-4-4-5 5v-1.5L9.5 15l-4-4 1.5-1.5L11.5 10l3-3 .5-3z";
                    }
                }
            }
        }
    }
}

component ArchiveRow inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 66px;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.input;
                Icon {
                    size: 22px;
                    commands: "M4 4h16a1 1 0 0 1 1 1v3H3V5a1 1 0 0 1 1-1zm0 6h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9zm5 3v2h6v-2H9z";
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: @tr("Archive");
                color: Theme.text;
                font-weight: 600;
                font-size: 15px;
            }

            Text {
                text: root.label;
                color: Theme.dim;
                font-size: 15px;
            }
        }
    }
}

// Chat folders as tabs, scrolled sideways by the wheel.
component FolderTabs inherits Rectangle {
    in property <[FolderTab]> tabs;
    callback pick(int);
    height: 40px;
    clip: true;
    function scroll(dy: length) {
        flick.content-x = max(min(0px, flick.width - flick.content-width), min(0px, flick.content-x + dy));
    }
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-width: max(row.preferred-width, self.width);
        interactive: false;
        TouchArea {
            width: parent.content-width;
            scroll-event(event) => {
                root.scroll(event.delta-y + event.delta-x);
                accept
            }
        }
        row := HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            alignment: start;
            for tab[index] in root.tabs: Rectangle {
                width: tab-row.preferred-width;
                tab-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick(index);
                    }
                    scroll-event(event) => {
                        root.scroll(event.delta-y + event.delta-x);
                        accept
                    }
                }
                tab-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        text: tab.title;
                        color: tab.on ? Theme.accent : tab-touch.has-hover ? Theme.text : Theme.dim;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    if tab.unread > 0: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 18px;
                            min-width: 18px;
                            border-radius: 9px;
                            background: tab.on ? Theme.accent : Theme.dim;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: tab.unread > 999 ? "999+" : tab.unread;
                                    color: Theme.accent-text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                if tab.on: Rectangle {
                    x: 8px;
                    y: parent.height - 3px;
                    width: parent.width - 16px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// One contact: avatar, name, last seen.
component ContactRow inherits Rectangle {
    in property <ContactItem> item;
    callback clicked();
    height: 58px;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Avatar {
                size: 42px;
                initial: root.item.initial;
                tint: root.item.color;
                photo: root.item.photo;
                has-photo: root.item.has-photo;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                color: Theme.text;
                font-weight: 600;
                font-size: 15px;
                overflow: elide;
            }

            Text {
                text: root.item.status;
                color: root.item.online ? Theme.accent : Theme.dim;
                font-size: 13px;
                overflow: elide;
            }
        }
    }
}

// A line of the profile column. The value wraps inside a box whose width is
// set by hand (not by a layout), and the row takes its height from the text.
component ProfileRow inherits Rectangle {
    in property <ProfileLine> line;
    height: 14px + value.preferred-height + 3px + 16px + 12px;
    value := Text {
        x: 20px;
        y: 14px;
        width: parent.width - 40px;
        text: root.line.value;
        color: Theme.text;
        font-size: 15px;
        wrap: word-wrap;
    }

    Text {
        x: 20px;
        y: 14px + value.preferred-height + 3px;
        width: parent.width - 40px;
        text: root.line.label;
        color: Theme.dim;
        font-size: 13px;
        overflow: elide;
    }
}

// The contacts window: search, then a list; a click opens the chat.
component ContactsWindow inherits Rectangle {
    in property <[ContactItem]> items;
    in property <string> note;
    callback close();
    callback filter(string);
    callback pick(int);
    callback avatar(int);
    background: #00000073;
    init => {
        search.focus();
    }
    // Swallows clicks and the wheel; a click on the dim area closes the window.
    TouchArea {
        clicked => {
            root.close();
        }
        scroll-event(event) => {
            accept
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(400px, parent.width - 32px);
        height: min(560px, parent.height - 48px);
        border-radius: 12px;
        background: Theme.raised;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        clip: true;
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                height: 56px;
                padding-left: 18px;
                padding-right: 10px;
                Text {
                    text: @tr("Contacts");
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: close-touch.has-hover ? Theme.hover : transparent;
                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.close();
                            }
                        }
                        StrokeIcon {
                            size: 20px;
                            x: 8px;
                            y: 8px;
                            stroke-width: 2px;
                            commands: "M6 6l12 12M18 6L6 18";
                        }
                    }
                }
            }

            Rectangle {
                height: 50px;
                Rectangle {
                    x: 14px;
                    y: 0;
                    width: parent.width - 28px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.input;
                    border-width: 1px;
                    border-color: search.has-focus ? Theme.accent : transparent;
                    if search.text == "": Text {
                        x: 14px;
                        height: parent.height;
                        text: @tr("Search");
                        color: Theme.dim;
                        vertical-alignment: center;
                    }
                    search := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        color: Theme.text;
                        selection-background-color: #4a7bb7;
                        edited => {
                            root.filter(self.text);
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                ListView {
                    width: parent.width;
                    height: parent.height;
                    for item[index] in root.items: ContactRow {
                        item: item;
                        init => {
                            if (!item.has-photo) {
                                root.avatar(index);
                            }
                        }
                        clicked => {
                            root.pick(index);
                        }
                    }
                }

                if root.items.length == 0: Text {
                    text: root.note;
                    color: Theme.dim;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    background: Theme.pill;
    border-radius: 13px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 3px;
        padding-bottom: 3px;
        Text {
            text: root.text;
            color: #e3eaf1;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

// Time, "изменено" and check marks at the bottom right of a bubble.
component Meta inherits HorizontalLayout {
    in property <MessageItem> m;
    // Drawn over a picture, on a dark pill.
    in property <bool> on-media;
    alignment: end;
    spacing: 3px;
    property <color> tint: root.on-media ? white : root.m.outgoing ? #ffffff99 : Theme.dim;
    Text {
        text: (root.m.edited ? @tr("edited ") : "") + root.m.time;
        color: root.tint;
        font-size: 11px;
        vertical-alignment: bottom;
    }

    if root.m.ticks > 0: VerticalLayout {
        alignment: end;
        Ticks {
            count: root.m.ticks;
            tint: root.m.ticks > 1 && !root.on-media ? Theme.read-tick : root.tint;
        }
    }
}

// The reactions under a message: emoji (or a custom emoji's picture) and a
// count; the own one is marked. A click sets or removes the own reaction.
component Reactions inherits VerticalLayout {
    in property <[ReactionRow]> rows;
    in property <bool> outgoing;
    callback react(int, string);
    callback want-emoji(string);
    spacing: 4px;
    for row in root.rows: HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for chip in row.chips: Rectangle {
            width: chip-row.preferred-width;
            height: 26px;
            border-radius: 13px;
            background: chip.mine ? (root.outgoing ? #ffffff45 : #3a6ea5) : (root.outgoing ? #ffffff1f : Theme.hover);
            border-width: chip.mine ? 1px : 0;
            border-color: root.outgoing ? #ffffffa0 : Theme.accent;
            init => {
                if (chip.custom != "" && !chip.has-image) {
                    root.want-emoji(chip.custom);
                }
            }
            TouchArea {
                mouse-cursor: chip.enabled ? pointer : default;
                clicked => {
                    if (chip.enabled) {
                        root.react(chip.message, chip.key);
                    }
                }
            }
            chip-row := HorizontalLayout {
                padding-left: 8px;
                padding-right: 9px;
                spacing: 4px;
                if chip.has-image: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 18px;
                        height: 18px;
                        source: chip.image;
                    }
                }
                if !chip.has-image: Text {
                    text: chip.text;
                    font-size: 15px;
                    vertical-alignment: center;
                }
                if chip.count > 1: Text {
                    text: chip.count;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The pictures of a bubble. Each cell asks for its picture when created,
// so only rows on screen (plus the list's margin) download anything.
component MediaBox inherits Rectangle {
    in property <MessageItem> m;
    in property <float> k: 1;
    callback want(int);
    callback open(int);
    callback context(length, length);
    callback wheel(length);
    width: root.m.media-w * root.k;
    height: root.m.media-h * root.k;
    for c in root.m.cells: Rectangle {
        x: c.x * root.k;
        y: c.y * root.k;
        width: c.w * root.k;
        height: c.h * root.k;
        property <length> r: root.m.round ? self.width / 2 : root.m.sticker ? 0 : 12px;
        border-top-left-radius: c.tl ? self.r : 0;
        border-top-right-radius: c.tr ? self.r : 0;
        border-bottom-left-radius: c.bl ? self.r : 0;
        border-bottom-right-radius: c.br ? self.r : 0;
        // Reserved before the picture arrives, so nothing jumps.
        background: c.state == 2 || root.m.sticker ? transparent : Theme.input;
        init => {
            if (c.state == 0) {
                root.want(c.id);
            }
        }
        if c.state == 2: Image {
            width: parent.width;
            height: parent.height;
            source: c.image;
            image-fit: fill;
        }
        if c.state == 3 || c.state == 4: Text {
            width: parent.width;
            height: parent.height;
            text: c.state == 3 ? @tr("Failed to load") : @tr("Show");
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if c.play: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: #0000008c;
            Path {
                x: 15px;
                y: 13px;
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                fill: white;
                commands: "M6 3.5l14 8.5-14 8.5z";
            }
        }
        if c.badge != "": Rectangle {
            x: 8px;
            y: 8px;
            width: badge.preferred-width + 14px;
            height: 18px;
            border-radius: 9px;
            background: #00000080;
            badge := Text {
                x: 7px;
                width: self.preferred-width;
                height: parent.height;
                text: c.badge;
                color: white;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: root.m.sticker ? default : pointer;
            clicked => {
                root.open(c.id);
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            scroll-event(event) => {
                root.wheel(event.delta-y);
                accept
            }
        }
    }
}

// Player row of a voice message or audio file: round button, waveform (or a
// plain bar) that seeks on click and drag, and the time.
// A file card: a round button (download / cancel / the extension once
// downloaded), the name, and the size or the download progress.
component FileRow inherits Rectangle {
    in property <FileItem> f;
    in property <bool> outgoing;
    in property <bool> select-mode;
    callback pick();
    callback click(int);
    callback context(length, length);
    callback wheel(length);
    height: 48px;
    property <color> lit: root.outgoing ? #ffffff : Theme.accent;
    property <color> dim: root.outgoing ? #ffffffb3 : Theme.dim;
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.select-mode) {
                root.pick();
            } else {
                root.click(root.f.id);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        scroll-event(event) => {
            root.wheel(event.delta-y);
            accept
        }
    }

    Rectangle {
        x: 0;
        y: 2px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: root.lit;
        // Not downloaded: an arrow down
        if root.f.state == 0: Path {
            x: 10px;
            y: 10px;
            width: 24px;
            height: 24px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 5v11M7 11l5 5 5-5M6 19h12";
            stroke: root.outgoing ? Theme.bubble-out : Theme.accent-text;
            stroke-width: 2.2px;
        }
        // Downloading: a cross that cancels
        if root.f.state == 1: Path {
            x: 13px;
            y: 13px;
            width: 18px;
            height: 18px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M6 6l12 12M18 6L6 18";
            stroke: root.outgoing ? Theme.bubble-out : Theme.accent-text;
            stroke-width: 2.6px;
        }
        // Downloaded: the extension; a click opens the file
        if root.f.state == 2: Text {
            width: parent.width;
            height: parent.height;
            text: root.f.ext;
            color: root.outgoing ? Theme.bubble-out : Theme.accent-text;
            font-size: (root.f.ext.character-count > 3 ? 10px : 12px) * Theme.scale;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 54px;
        y: 4px;
        width: parent.width - 54px;
        text: root.f.name;
        color: Theme.text;
        font-size: 15px * Theme.scale;
        font-weight: 600;
        overflow: elide;
    }

    if root.f.state == 1: Rectangle {
        x: 54px;
        y: 27px;
        width: parent.width - 54px;
        height: 3px;
        border-radius: 1.5px;
        background: root.outgoing ? #ffffff40 : #7f91a440;
        Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.f.progress));
            height: parent.height;
            border-radius: 1.5px;
            background: root.lit;
        }
    }

    Text {
        x: 54px;
        y: root.f.state == 1 ? 32px : 27px;
        width: parent.width - 54px;
        text: root.f.size;
        color: root.dim;
        font-size: 13px * Theme.scale;
        overflow: elide;
    }
}

component TrackRow inherits Rectangle {
    in property <MessageItem> m;
    in property <bool> select-mode;
    callback pick();
    callback context(length, length);
    callback wheel(length);
    width: 230px;
    height: 44px;
    property <bool> active: Player.shown == root.m.id && Player.state != 0;
    property <bool> running: root.active && Player.state == 2;
    property <bool> dragging: false;
    property <float> scrub: 0;
    property <float> shown-progress: root.dragging ? root.scrub : root.active ? Player.progress : 0;
    property <color> base: root.m.outgoing ? #ffffff59 : #7f91a466;
    property <color> lit: root.m.outgoing ? #ffffff : Theme.accent;
    property <length> bar-w: 180px;
    // Round button
    Rectangle {
        x: 0;
        y: 0;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: root.m.outgoing ? #ffffff : Theme.accent;
        if !root.running: Path {
            x: 11px;
            y: 10px;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M7 4 L20 12 L7 20 Z";
            fill: root.m.outgoing ? Theme.bubble-out : Theme.accent-text;
        }
        if root.running: Path {
            x: 11px;
            y: 10px;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M6 4 L10 4 L10 20 L6 20 Z M14 4 L18 4 L18 20 L14 20 Z";
            fill: root.m.outgoing ? Theme.bubble-out : Theme.accent-text;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.select-mode) {
                    root.pick();
                } else {
                    Player.toggle(root.m.id);
                }
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            scroll-event(event) => {
                root.wheel(event.delta-y);
                accept
            }
        }
    }

    // Title of an audio file
    if root.m.track == 2: Text {
        x: 50px;
        y: 2px;
        width: root.bar-w;
        text: root.m.track-title;
        color: Theme.text;
        font-size: 14px;
        overflow: elide;
    }
    // Waveform
    if root.m.wave != "": Rectangle {
        x: 50px;
        y: 0px;
        width: root.bar-w;
        height: 26px;
        Path {
            width: 180px;
            height: 26px;
            viewbox-width: 180;
            viewbox-height: 26;
            commands: root.m.wave;
            stroke: root.base;
            stroke-width: 2.5px;
            fill: transparent;
        }
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.shown-progress;
            height: parent.height;
            clip: true;
            Path {
                x: 0;
                y: 0;
                width: 180px;
                height: 26px;
                viewbox-width: 180;
                viewbox-height: 26;
                commands: root.m.wave;
                stroke: root.lit;
                stroke-width: 2.5px;
                fill: transparent;
            }
        }
    }
    // Plain bar: audio files and voice without a waveform
    if root.m.wave == "": Rectangle {
        x: 50px;
        y: root.m.track == 2 ? 26px : 11px;
        width: root.bar-w;
        height: 4px;
        border-radius: 2px;
        background: root.base;
        Rectangle {
            width: parent.width * root.shown-progress;
            height: parent.height;
            border-radius: 2px;
            background: root.lit;
        }
        Rectangle {
            x: parent.width * root.shown-progress - 5px;
            y: -3px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.lit;
            visible: root.active;
        }
    }
    Text {
        x: 50px;
        y: 29px;
        text: root.active ? Player.elapsed + (Player.state == 1 ? "" : " / " + root.m.track-total) : root.m.track-total;
        color: root.m.outgoing ? #ffffff99 : Theme.dim;
        font-size: 12px;
    }
    // Seek area over the bar
    TouchArea {
        x: 50px;
        y: 0px;
        width: root.bar-w;
        height: 34px;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                if (root.select-mode) {
                    root.pick();
                } else {
                    root.dragging = true;
                    root.scrub = clamp(self.mouse-x / self.width, 0, 1);
                }
            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                Player.seek(root.m.id, clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        moved => {
            if (root.dragging) {
                root.scrub = clamp(self.mouse-x / self.width, 0, 1);
            }
        }
        scroll-event(event) => {
            root.wheel(event.delta-y);
            accept
        }
    }
}

component MessageView inherits VerticalLayout {
    in property <MessageItem> m;
    in property <length> max-bubble;
    callback context(length, length);
    callback wheel(length);
    // Text is drawn with the light Text element; only a message picked with
    // "Выделить текст" in its menu becomes a selectable TextInput. A
    // TextInput per bubble made rows several times costlier to create while
    // scrolling (stalls up to 165 ms, against ~20 ms with Text).
    in property <bool> selecting;
    // A left click on another bubble ends the selection mode.
    callback stop-select();
    callback want-picture(int);
    callback open-picture(int);
    // A click on a file card: download, cancel or open.
    callback file-click(int);
    // A click on a link in the text (its target, see links.rs).
    callback open-link(string);
    // A click on the quote of a reply: the answered message.
    callback open-reply(int);
    // An inline button: message id, row, column.
    callback press-button(int, int, int);
    // The comments of a channel post: message id.
    callback open-discussion(int);
    callback react(int, string);
    callback want-emoji(string);
    // Selection mode: a click on the bubble picks it instead of acting.
    in property <bool> select-mode;
    callback pick(int);
    padding-top: root.m.hidden || root.m.day != "" ? 0 : root.m.joined ? 2px : 8px;
    if root.m.day != "": HorizontalLayout {
        alignment: center;
        padding-top: 8px;
        padding-bottom: 8px;
        Pill {
            text: root.m.day;
        }
    }
    if root.m.service: HorizontalLayout {
        alignment: center;
        Pill {
            text: root.m.text;
            max-width: root.max-bubble;
        }
    }
    if !root.m.service && !root.m.hidden: HorizontalLayout {
        alignment: root.m.outgoing ? end : start;
        bubble := Rectangle {
            property <bool> has-media: root.m.media-w > 0;
            // Stickers and round videos have no bubble at all.
            property <bool> bare: root.m.sticker || root.m.round;
            property <length> mpad: self.bare ? 0 : root.m.media-only ? 3px : 4px;
            // Channel posts all take the full width, pictures scaled to it.
            property <bool> wide: root.m.wide && !self.bare;
            // Otherwise a bubble with pictures is exactly as wide as the
            // pictures; a narrow window scales them down.
            property <length> mw: self.wide ? root.max-bubble - 2 * self.mpad : min(root.m.media-w, root.max-bubble - 2 * self.mpad);
            property <float> k: self.has-media ? self.mw / root.m.media-w : 1;
            property <length> pad-x: self.has-media ? self.mpad + 7px : 11px;
            property <length> mh: root.m.media-h * self.k;
            // The pictures are placed by hand above the text: a wrapped text
            // inside a nested layout got a wrong height and spilled out.
            property <length> media-top: root.m.sender != "" ? 6px + sender.preferred-height + 4px : self.mpad;
            // Room for text inside the widest bubble.
            property <length> max-text: (self.has-media ? self.mw + 2 * self.mpad : root.max-bubble) - 2 * self.pad-x;
            property <length> meta-w: meta-probe.preferred-width + 10px;
            // A short single line keeps the time on the same line, as Telegram does.
            property <bool> inline: !root.m.multiline && root.m.text != "" && measure.preferred-width + self.meta-w <= self.max-text;
            property <length> content: max(self.inline ? measure.preferred-width + self.meta-w : min(measure.preferred-width, self.max-text), meta-probe.preferred-width, sender.preferred-width, kind.preferred-width, react-probe.preferred-width, root.m.track > 0 ? 230px : 0px, root.m.files.length > 0 ? 260px : 0px, root.m.buttons.length > 0 ? 240px : 0px, root.m.reply ? min(260px, max(reply-who-probe.preferred-width, reply-text-probe.preferred-width) + 14px) : 0px);
            width: self.has-media ? self.mw + 2 * self.mpad : self.wide ? root.max-bubble : min(root.max-bubble, self.content + 2 * self.pad-x + 1px);
            background: self.bare ? transparent : root.m.outgoing ? Theme.bubble-out : Theme.bubble-in;
            border-top-left-radius: 18px;
            border-top-right-radius: 18px;
            border-bottom-left-radius: root.m.tail && !root.m.outgoing ? 6px : 18px;
            border-bottom-right-radius: root.m.tail && root.m.outgoing ? 6px : 18px;
            measure := Text {
                text: root.m.text;
                font-size: 15.5px * Theme.scale;
                visible: false;
            }

            meta-probe := Meta {
                m: root.m;
                visible: false;
            }

            // Widths of the optional lines, measured outside the layout.
            sender := Text {
                text: root.m.sender;
                font-size: 13px * Theme.scale;
                font-weight: 600;
                visible: false;
            }

            kind := Text {
                text: root.m.media;
                font-size: 14px * Theme.scale;
                visible: false;
            }

            react-probe := Reactions {
                rows: root.m.reactions;
                visible: false;
            }

            reply-who-probe := Text {
                text: root.m.reply-who;
                font-size: 13px * Theme.scale;
                font-weight: 600;
                visible: false;
            }

            reply-text-probe := Text {
                text: root.m.reply-text;
                font-size: 13px * Theme.scale;
                visible: false;
            }

            height: content.preferred-height;
            // Below the text: a right click on it is ignored by the text input and lands here.
            TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.select-mode) {
                        root.pick(root.m.id);
                    } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && !root.selecting) {
                        root.stop-select();
                    }
                    if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                        root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                scroll-event(event) => {
                    root.wheel(event.delta-y);
                    accept
                }
            }

            if bubble.has-media && root.m.sender != "": Text {
                x: bubble.pad-x;
                y: 6px;
                width: parent.width - 2 * bubble.pad-x;
                text: root.m.sender;
                color: root.m.sender-color;
                font-size: 13px * Theme.scale;
                font-weight: 600;
                overflow: elide;
            }
            if bubble.has-media: MediaBox {
                x: bubble.mpad;
                y: bubble.media-top;
                m: root.m;
                k: bubble.k;
                want(id) => {
                    root.want-picture(id);
                }
                open(id) => {
                    if (root.select-mode) {
                        root.pick(root.m.id);
                    } else {
                        root.open-picture(id);
                    }
                }
                context(x, y) => {
                    root.context(x, y);
                }
                wheel(dy) => {
                    root.wheel(dy);
                }
            }

            content := VerticalLayout {
                width: parent.width;
                padding-left: bubble.pad-x;
                padding-right: bubble.pad-x;
                // Room for the pictures placed above.
                padding-top: !bubble.has-media ? 6px : root.m.media-only ? bubble.media-top + bubble.mh : bubble.media-top + bubble.mh + 5px;
                padding-bottom: root.m.media-only ? bubble.mpad : 6px;
                spacing: 3px;
                // Conditional, not hidden: a hidden child still gets the
                // layout's spacing and leaves a gap above the text.
                if root.m.sender != "" && !bubble.has-media: Text {
                    text: root.m.sender;
                    color: root.m.sender-color;
                    font-size: 13px * Theme.scale;
                    font-weight: 600;
                }
                if root.m.track > 0: TrackRow {
                    m: root.m;
                    select-mode: root.select-mode;
                    pick => {
                        root.pick(root.m.id);
                    }
                    context(x, y) => {
                        root.context(x, y);
                    }
                    wheel(dy) => {
                        root.wheel(dy);
                    }
                }
                // The quote of the answered message; a click jumps to it.
                if root.m.reply: Rectangle {
                    height: 40px * Theme.scale;
                    border-radius: 4px;
                    background: root.m.outgoing ? #ffffff1f : #6ab3f31a;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: 3px;
                        height: parent.height;
                        background: root.m.outgoing ? #ffffff : Theme.accent;
                    }
                    Text {
                        x: 10px;
                        y: 3px * Theme.scale;
                        width: parent.width - 16px;
                        text: root.m.reply-who;
                        color: root.m.outgoing ? #ffffff : Theme.accent;
                        font-size: 13px * Theme.scale;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        x: 10px;
                        y: 21px * Theme.scale;
                        width: parent.width - 16px;
                        text: root.m.reply-text;
                        color: root.m.outgoing ? Theme.text-out : Theme.text;
                        font-size: 13px * Theme.scale;
                        overflow: elide;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.select-mode) {
                                root.pick(root.m.id);
                            } else {
                                root.open-reply(root.m.id);
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                        scroll-event(event) => {
                            root.wheel(event.delta-y);
                            accept
                        }
                    }
                }
                for f in root.m.files: FileRow {
                    f: f;
                    outgoing: root.m.outgoing;
                    select-mode: root.select-mode;
                    pick => {
                        root.pick(root.m.id);
                    }
                    click(id) => {
                        root.file-click(id);
                    }
                    context(x, y) => {
                        root.context(x, y);
                    }
                    wheel(dy) => {
                        root.wheel(dy);
                    }
                }
                if root.m.media != "": Text {
                    TouchArea {
                        enabled: root.m.media-link != "" && !root.select-mode;
                        mouse-cursor: self.enabled ? pointer : default;
                        clicked => {
                            root.open-link(root.m.media-link);
                        }
                    }
                    wrap: word-wrap;
                    text: root.m.media;
                    color: root.m.outgoing ? #a9d4ff : Theme.accent;
                    font-size: 14px * Theme.scale;
                }

                if bubble.inline: HorizontalLayout {
                    spacing: 10px;
                    if root.selecting: TextInput {
                        text: root.m.text;
                        read-only: true;
                        single-line: true;
                        color: root.m.outgoing ? Theme.text-out : Theme.text;
                        font-size: 15.5px * Theme.scale;
                        selection-background-color: #4a7bb7;
                        selection-foreground-color: white;
                        init => {
                            self.focus();
                        }
                    }
                    if !root.selecting && !root.m.linked: Text {
                        text: root.m.text;
                        color: root.m.outgoing ? Theme.text-out : Theme.text;
                        font-size: 15.5px * Theme.scale;
                    }
                    if !root.selecting && root.m.linked: StyledText {
                        text: root.m.rich;
                        default-color: root.m.outgoing ? Theme.text-out : Theme.text;
                        default-font-size: 15.5px * Theme.scale;
                        link-color: root.m.outgoing ? #cfe7ff : Theme.accent;
                        link-clicked(link) => {
                            if (!root.select-mode) {
                                root.open-link(link);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 1px;
                        Meta {
                            m: root.m;
                        }
                    }
                }
                if !bubble.inline && root.m.text != "" && root.selecting: TextInput {
                    text: root.m.text;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: root.m.outgoing ? Theme.text-out : Theme.text;
                    font-size: 15.5px * Theme.scale;
                    selection-background-color: #4a7bb7;
                    selection-foreground-color: white;
                    init => {
                        self.focus();
                    }
                }
                if !bubble.inline && root.m.text != "" && !root.selecting && !root.m.linked: Text {
                    text: root.m.text;
                    wrap: word-wrap;
                    color: root.m.outgoing ? Theme.text-out : Theme.text;
                    font-size: 15.5px * Theme.scale;
                }
                if !bubble.inline && root.m.text != "" && !root.selecting && root.m.linked: StyledText {
                    text: root.m.rich;
                    default-color: root.m.outgoing ? Theme.text-out : Theme.text;
                    default-font-size: 15.5px * Theme.scale;
                    link-color: root.m.outgoing ? #cfe7ff : Theme.accent;
                    link-clicked(link) => {
                        if (!root.select-mode) {
                            root.open-link(link);
                        }
                    }
                }
                // Inline buttons, row by row.
                for row in root.m.buttons: HorizontalLayout {
                    spacing: 4px;
                    for b in row.items: Rectangle {
                        height: 34px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: key-touch.has-hover ? #ffffff2e : #ffffff17;
                        key-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.select-mode) {
                                    root.pick(root.m.id);
                                } else {
                                    root.press-button(root.m.id, b.row, b.col);
                                }
                            }
                        }
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text: b.link ? b.text + " ↗" : b.text;
                            color: root.m.outgoing ? Theme.text-out : Theme.accent;
                            font-size: 14px * Theme.scale;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                // A channel post's comments: how many, and the way into the
                // discussion group ("12 comments").
                if root.m.comments-text != "": Rectangle {
                    height: 24px;
                    comments-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.select-mode) {
                                root.pick(root.m.id);
                            } else {
                                root.open-discussion(root.m.id);
                            }
                        }
                    }
                    Text {
                        height: parent.height;
                        text: root.m.comments-text;
                        color: comments-touch.has-hover ? Theme.accent : Theme.dim;
                        font-size: 13px * Theme.scale;
                        vertical-alignment: center;
                    }
                }
                if root.m.reactions.length > 0: Reactions {
                    rows: root.m.reactions;
                    outgoing: root.m.outgoing;
                    react(message, key) => {
                        root.react(message, key);
                    }
                    want-emoji(id) => {
                        root.want-emoji(id);
                    }
                }
                if !bubble.inline && !root.m.media-only: Meta {
                    m: root.m;
                }
            }

            // Pictures without a caption: the time sits on the picture.
            if root.m.media-only: Rectangle {
                x: parent.width - bubble.mpad - self.width - 6px;
                y: parent.height - bubble.mpad - self.height - 6px;
                width: on-pic.preferred-width + 14px;
                height: 20px;
                border-radius: 10px;
                background: #00000073;
                on-pic := Meta {
                    x: 7px;
                    width: self.preferred-width;
                    height: parent.height;
                    m: root.m;
                    on-media: true;
                    alignment: center;
                }
            }
        }
    }
}

component LoginCard inherits Rectangle {
    // Wrapped texts get the card's inner width: inside nested layouts Slint
    // measured them as one line, and the card came out too short.
    property <length> text-width: min(380px, root.width - 48px) - 48px;
    in property <string> stage;
    // The code step: where the code went; "send another way" (empty: none)
    in property <string> code-hint;
    in property <string> resend-text;
    in property <bool> resend-ready;
    callback resend-code();
    // The QR step: the code as path commands in a qr-size box
    in property <string> qr-path;
    in property <int> qr-size: 1;
    callback qr-start();
    // The phone step: the chosen country, the number's mask, the list.
    in property <string> phone-flag;
    in property <string> phone-dial;
    in property <string> phone-mask;
    in property <string> phone-country;
    // Set from Rust (formatting while typing); `phone-text-serial` changes
    // each time so the field takes it.
    in property <string> phone-text;
    in property <int> phone-text-bytes;
    in property <int> phone-text-serial;
    in-out property <bool> country-open;
    in property <[CountryItem]> country-items;
    callback phone-edited(string);
    callback country-filter(string);
    callback country-pick(int);
    // The lock screen ("locked")
    callback unlock(string);
    callback forgot-passcode();
    in property <string> phone;
    in property <string> hint;
    in property <string> error;
    in property <bool> busy;
    in property <bool> keys-rejected;
    callback save-keys(string, string);
    callback request-code(string);
    callback submit-code(string);
    callback submit-password(string);
    callback back-to-phone();
    callback change-keys();
    callback open-proxy();
    background: Theme.bg;

    VerticalLayout {
        alignment: center;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(380px, root.width - 48px);
                background: Theme.raised;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text {
                        text: root.stage == "keys" ? @tr("Telegram API keys") : root.stage == "phone" ? @tr("Sign in to Telegram") : root.stage == "code" ? @tr("Confirmation code") : root.stage == "password" ? @tr("Cloud password") : root.stage == "locked" ? @tr("Oxigram is locked") : root.stage == "qr" ? @tr("Sign in with a QR code") : "Oxigram";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    if root.stage == "loading": VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: @tr("Connecting…");
                            color: Theme.dim;
                            font-size: 15px;
                        }

                        // A connection that hangs is usually a blocked
                        // network: the proxy has to be within reach from
                        // here too, not only from the keys screen.
                        Button {
                            kind: "link";
                            text: @tr("Set up proxy");
                            clicked => {
                                root.open-proxy();
                            }
                        }
                    }

                    if root.stage == "keys": VerticalLayout {
                        spacing: 14px;
                        Text {
                            text: @tr("Oxigram works only with your own keys. Get an api_id and api_hash at my.telegram.org → API development tools.");
                            color: Theme.dim;
                            wrap: word-wrap;
                            width: root.text-width;
                            font-size: 14px;
                        }

                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "api_id";
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            api-id := Field {
                                placeholder: "1234567";
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    api-hash.grab-focus();
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: "api_hash";
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            api-hash := Field {
                                placeholder: @tr("32 characters");
                                enabled: !root.busy;
                                accepted => {
                                    root.save-keys(api-id.text, api-hash.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? @tr("Saving…") : @tr("Save");
                            enabled: !root.busy;
                            clicked => {
                                root.save-keys(api-id.text, api-hash.text);
                            }
                        }

                        // Keys are checked by connecting: where Telegram is
                        // blocked, the proxy has to come first.
                        Button {
                            kind: "link";
                            text: @tr("Set up proxy");
                            enabled: !root.busy;
                            clicked => {
                                root.open-proxy();
                            }
                        }
                    }

                    if root.stage == "phone": VerticalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 5px;
                            // Rust formats the number while it is typed.
                            property <int> serial: root.phone-text-serial;
                            changed serial => {
                                phone-field.set-text-end(root.phone-text, root.phone-text-bytes);
                            }
                            Text {
                                text: @tr("Phone number");
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                // The country: flag and code; a click opens the list.
                                Rectangle {
                                    width: 104px;
                                    height: 40px;
                                    border-radius: 8px;
                                    background: country-touch.has-hover ? Theme.hover : Theme.input;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    country-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        enabled: !root.busy;
                                        clicked => {
                                            root.country-filter("");
                                            root.country-open = true;
                                        }
                                    }
                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        text: root.phone-dial != "" ? root.phone-flag + "  " + root.phone-dial : @tr("Code");
                                        color: root.phone-dial != "" ? Theme.text : Theme.dim;
                                        font-size: 15px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                phone-field := Field {
                                    placeholder: root.phone-mask != "" ? root.phone-mask : "+0 000 000 0000";
                                    enabled: !root.busy;
                                    init => {
                                        self.grab-focus();
                                    }
                                    edited(text) => {
                                        root.phone-edited(text);
                                    }
                                    accepted => {
                                        root.request-code(self.text);
                                    }
                                }
                            }

                            if root.phone-country != "": Text {
                                text: root.phone-country;
                                color: Theme.dim;
                                font-size: 12px;
                            }
                        }

                        Button {
                            text: root.busy ? @tr("Sending…") : @tr("Get code");
                            enabled: !root.busy;
                            clicked => {
                                root.request-code(phone-field.text);
                            }
                        }

                        Button {
                            kind: "link";
                            text: @tr("Sign in with a QR code");
                            enabled: !root.busy;
                            clicked => {
                                root.qr-start();
                            }
                        }

                        Button {
                            kind: "link";
                            text: @tr("Other API keys");
                            enabled: !root.busy;
                            clicked => {
                                root.change-keys();
                            }
                        }

                        Button {
                            kind: "link";
                            text: @tr("Set up proxy");
                            enabled: !root.busy;
                            clicked => {
                                root.open-proxy();
                            }
                        }
                    }

                    if root.stage == "code": VerticalLayout {
                        spacing: 14px;
                        Text {
                            text: root.code-hint;
                            color: Theme.dim;
                            wrap: word-wrap;
                            width: root.text-width;
                            font-size: 14px;
                        }

                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: @tr("Code");
                                color: Theme.dim;
                                font-size: 13px;
                            }

                            code-field := Field {
                                placeholder: "12345";
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    root.submit-code(self.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? @tr("Checking…") : @tr("Sign in");
                            enabled: !root.busy;
                            clicked => {
                                root.submit-code(code-field.text);
                            }
                        }

                        if root.resend-text != "": Button {
                            kind: "link";
                            text: root.resend-text;
                            enabled: root.resend-ready && !root.busy;
                            clicked => {
                                root.resend-code();
                            }
                        }

                        Button {
                            kind: "link";
                            text: @tr("Different number");
                            enabled: !root.busy;
                            clicked => {
                                root.back-to-phone();
                            }
                        }
                    }

                    if root.stage == "qr": VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 220px;
                                height: 220px;
                                border-radius: 12px;
                                background: white;
                                Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: root.qr-size;
                                    viewbox-height: root.qr-size;
                                    commands: root.qr-path;
                                    fill: black;
                                }
                            }
                        }

                        Text {
                            text: @tr("On your phone, open Telegram → Settings → Devices → Link Desktop Device, and point the camera at this code.");
                            color: Theme.dim;
                            font-size: 14px;
                            wrap: word-wrap;
                            width: root.text-width;
                            horizontal-alignment: center;
                        }

                        Button {
                            kind: "link";
                            text: @tr("Sign in with a phone number");
                            enabled: !root.busy;
                            clicked => {
                                root.back-to-phone();
                            }
                        }
                    }

                    if root.stage == "locked": VerticalLayout {
                        spacing: 14px;
                        Text {
                            text: @tr("Enter passcode");
                            color: Theme.dim;
                            font-size: 14px;
                        }

                        passcode-field := Field {
                            password: true;
                            placeholder: @tr("Passcode");
                            enabled: !root.busy;
                            init => {
                                self.grab-focus();
                            }
                            accepted => {
                                root.unlock(self.text);
                                self.text = "";
                            }
                        }

                        Button {
                            text: root.busy ? @tr("Checking…") : @tr("Unlock");
                            enabled: !root.busy;
                            clicked => {
                                root.unlock(passcode-field.text);
                                passcode-field.text = "";
                            }
                        }

                        Button {
                            kind: "link";
                            text: @tr("Forgot passcode?");
                            enabled: !root.busy;
                            clicked => {
                                root.forgot-passcode();
                            }
                        }
                    }

                    if root.stage == "password": VerticalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 5px;
                            Text {
                                text: root.hint != "" ? @tr("Password (hint: {})", root.hint) : @tr("Two-step verification password");
                                color: Theme.dim;
                                font-size: 13px;
                                wrap: word-wrap;
                                width: root.text-width;
                            }

                            password-field := Field {
                                password: true;
                                enabled: !root.busy;
                                init => {
                                    self.grab-focus();
                                }
                                accepted => {
                                    root.submit-password(self.text);
                                }
                            }
                        }

                        Button {
                            text: root.busy ? @tr("Checking…") : @tr("Sign in");
                            enabled: !root.busy;
                            clicked => {
                                root.submit-password(password-field.text);
                            }
                        }

                        Button {
                            kind: "link";
                            text: @tr("Start over");
                            enabled: !root.busy;
                            clicked => {
                                root.back-to-phone();
                            }
                        }
                    }

                    if root.error != "": Text {
                        text: root.error;
                        color: Theme.danger;
                        wrap: word-wrap;
                        width: root.text-width;
                        font-size: 14px;
                    }
                    if root.keys-rejected: Button {
                        kind: "ghost";
                        text: @tr("Re-enter keys");
                        clicked => {
                            root.change-keys();
                        }
                    }
                }
            }
        }
    }

    // ---- The country list (phone step)
    if root.country-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000073;
        TouchArea {
            clicked => {
                root.country-open = false;
            }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(16px, (parent.height - self.height) / 2);
            width: min(380px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            border-radius: 12px;
            background: Theme.raised;
            drop-shadow-blur: 20px;
            drop-shadow-color: #00000066;
            TouchArea { }
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: @tr("Country");
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 600;
                }

                country-search := Field {
                    placeholder: @tr("Search by name or code");
                    init => {
                        self.grab-focus();
                    }
                    edited(text) => {
                        root.country-filter(text);
                    }
                    accepted => {
                        root.country-pick(0);
                    }
                }

                ListView {
                    for item[index] in root.country-items: Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: row-touch.has-hover ? Theme.hover : transparent;
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.country-pick(index);
                            }
                        }
                        Text {
                            x: 10px;
                            width: 28px;
                            height: parent.height;
                            text: item.flag;
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                        Text {
                            x: 44px;
                            width: parent.width - 44px - 70px;
                            height: parent.height;
                            text: item.name;
                            color: Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 70px;
                            width: 60px;
                            height: parent.height;
                            text: item.dial;
                            color: Theme.dim;
                            font-size: 14px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

component DrawerItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 44px;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Text {
        x: 18px;
        text: root.text;
        color: Theme.text;
        font-size: 15px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 40px;
    min-width: 110px;
    border-radius: 8px;
    background: touch.has-hover ? #ff8585 : Theme.danger;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: #1a0505;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A dialog box over a dimmed window; a click outside closes it.
component Modal inherits Rectangle {
    in property <string> title;
    in property <length> box-width: 420px;
    callback close();
    background: #00000073;
    // Swallows clicks and the wheel: neither may reach the window below.
    TouchArea {
        clicked => {
            root.close();
        }
        scroll-event(event) => {
            accept
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(root.box-width, parent.width - 32px);
        // Never taller than the window: a long dialog scrolls inside.
        height: min(body.preferred-height, parent.height - 32px);
        border-radius: 12px;
        background: Theme.raised;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        clip: true;
        TouchArea { }
        // Scrolled by hand: a wheel over the dialog never reached Slint's own
        // scrolling here. The touch area under the content takes the wheel
        // wherever the content itself does not (text, gaps, rows).
        flick := Flickable {
            width: parent.width;
            height: parent.height;
            content-height: body.preferred-height;
            interactive: false;
            TouchArea {
                width: parent.width;
                height: body.preferred-height;
                scroll-event(event) => {
                    flick.content-y = max(min(0px, flick.height - body.preferred-height), min(0px, flick.content-y + event.delta-y));
                    accept
                }
            }
            body := VerticalLayout {
                width: parent.width;
                padding: 22px;
                spacing: 16px;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                }

                @children
            }
        }
    }
}


// ---- Settings panel (like Telegram Web: a column that replaces the chat list)

// One line of a settings card: a coloured icon tile, a label, a value.
component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> tint;
    in property <string> icon;
    in property <bool> danger;
    callback clicked();
    height: 48px;
    border-radius: 10px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: root.tint;
                StrokeIcon {
                    x: 5px;
                    y: 5px;
                    tint: white;
                    stroke-width: 2px;
                    commands: root.icon;
                }
            }
        }

        Text {
            text: root.label;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: 15px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.value != "": Text {
            text: root.value;
            color: Theme.dim;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            max-width: 130px;
        }
    }
}

// A line of the profile card: the value and what it is.
component InfoRow inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <color> tint;
    in property <string> icon;
    height: 52px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: root.tint;
                StrokeIcon {
                    x: 5px;
                    y: 5px;
                    tint: white;
                    stroke-width: 2px;
                    commands: root.icon;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.value;
                color: Theme.text;
                font-size: 15px;
                overflow: elide;
            }

            Text {
                text: root.label;
                color: Theme.dim;
                font-size: 12px;
            }
        }
    }
}

// A switch with a title and a note. Heights are fixed (the note's line count
// comes from Rust): Slint mis-measures wrapped text in nested layouts.
component ToggleRow inherits Rectangle {
    in property <SaverOption> option;
    callback toggle(string);
    height: 12px + 21px + 2px + root.option.note-lines * 18px + 12px;
    border-radius: 10px;
    background: toggle-touch.has-hover ? Theme.hover : transparent;
    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggle(root.option.key);
        }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.option.title;
                color: Theme.text;
                font-size: 15px;
                overflow: elide;
                height: 21px;
            }

            Text {
                text: root.option.note;
                color: Theme.dim;
                font-size: 13px;
                wrap: word-wrap;
                height: root.option.note-lines * 18px;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 18px;
                border-radius: 9px;
                background: root.option.on ? Theme.accent : Theme.input;
                Rectangle {
                    x: root.option.on ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.option.on ? white : Theme.dim;
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    background: Theme.raised;
    border-radius: 14px;
    height: card-body.preferred-height;
    card-body := VerticalLayout {
        padding: 4px;
        @children
    }
}

component SettingsPanel inherits Rectangle {
    in-out property <string> page: "main";
    // "Язык": the current choice
    in property <string> language-label;
    callback cycle-language();
    // "Код-пароль"
    in property <bool> passcode-on;
    in property <string> passcode-status;
    in property <bool> passcode-busy;
    in property <string> auto-lock-text;
    callback passcode-enable(string, string);
    callback passcode-change(string, string, string);
    callback passcode-disable(string);
    callback cycle-auto-lock();
    callback lock-now();
    // Updates, in "О программе"
    in property <string> update-version;
    in property <string> update-status;
    in property <bool> update-busy;
    in property <float> update-progress;
    callback update-check();
    callback update-install();
    callback update-notes();
    // "О программе": GitHub, slint.dev
    callback open-url(string);
    in property <string> name;
    in property <string> phone;
    in property <string> username;
    in property <string> initial;
    in property <color> tint;
    in property <image> photo;
    in property <bool> has-photo;
    in property <[SaverOption]> options;
    in property <string> cache-text;
    in property <string> version;
    in property <string> proxy-summary;
    // "Мелкий" / "Обычный" / "Крупный"
    in property <string> text-size;
    callback cycle-text-size();
    callback close();
    callback toggle(string);
    callback clear-cache();
    callback sign-out();
    callback open-proxy();
    property <bool> muted: false;
    background: Theme.bg;
    // Swallows clicks and the wheel meant for the list below.
    TouchArea {
        scroll-event(event) => {
            accept
        }
    }
    // The page scrolls by hand (see Modal); a new page starts at the top.
    changed page => {
        flick.content-y = 0;
    }

    // Header
    Rectangle {
        y: 0;
        height: 56px;
        background: Theme.raised;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 8px;
            Rectangle {
                width: 40px;
                height: 40px;
                y: 8px;
                border-radius: 20px;
                background: back-touch.has-hover ? Theme.hover : transparent;
                back-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.page == "main") {
                            root.close();
                        } else {
                            root.page = "main";
                        }
                    }
                }
                StrokeIcon {
                    x: 10px;
                    y: 10px;
                    tint: Theme.text;
                    stroke-width: 2px;
                    commands: "M15 5l-7 7 7 7";
                }
            }

            Text {
                text: root.page == "notifications" ? @tr("Notifications") : root.page == "data" ? @tr("Data and Storage") : root.page == "general" ? @tr("General") : root.page == "about" ? @tr("About") : root.page == "passcode" ? @tr("Passcode") : @tr("Settings");
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    flick := Flickable {
        y: 56px;
        width: parent.width;
        height: parent.height - 56px;
        content-height: body.preferred-height;
        interactive: false;
        TouchArea {
            width: parent.width;
            height: max(body.preferred-height, flick.height);
            scroll-event(event) => {
                flick.content-y = max(min(0px, flick.height - body.preferred-height), min(0px, flick.content-y + event.delta-y));
                accept
            }
        }
        body := VerticalLayout {
            width: parent.width;
            padding: 12px;
            spacing: 12px;

            // ---- Main page: profile, then the sections
            if root.page == "main": VerticalLayout {
                spacing: 4px;
                padding-top: 8px;
                padding-bottom: 8px;
                HorizontalLayout {
                    alignment: center;
                    Avatar {
                        size: 96px;
                        initial: root.initial;
                        tint: root.tint;
                        photo: root.photo;
                        has-photo: root.has-photo;
                    }
                }

                Rectangle {
                    height: 6px;
                }

                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: 19px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: @tr("online");
                    color: Theme.accent;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }

            if root.page == "main" && (root.phone != "" || root.username != ""): SettingsCard {
                if root.phone != "": InfoRow {
                    value: root.phone;
                    label: @tr("Phone");
                    tint: #4cb05e;
                    icon: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z";
                }
                if root.username != "": InfoRow {
                    value: root.username;
                    label: @tr("Username");
                    tint: #3d8fd9;
                    icon: "M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-3.5 7.1";
                }
            }

            if root.page == "main": SettingsCard {
                SettingsRow {
                    label: @tr("Notifications");
                    tint: #e5534b;
                    icon: "M6 16V11a6 6 0 0 1 12 0v5l2 2H4l2-2zM10 20a2 2 0 0 0 4 0";
                    clicked => {
                        root.page = "notifications";
                    }
                }

                SettingsRow {
                    label: @tr("Data and Storage");
                    value: root.cache-text;
                    tint: #4cb05e;
                    icon: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3";
                    clicked => {
                        root.page = "data";
                    }
                }

                SettingsRow {
                    label: @tr("General");
                    tint: #6f8295;
                    icon: "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1";
                    clicked => {
                        root.page = "general";
                    }
                }

                SettingsRow {
                    label: @tr("Proxy");
                    value: root.proxy-summary;
                    tint: #3d8fd9;
                    icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9M12 3C9.5 5.5 8.2 8.5 8.2 12s1.3 6.5 3.8 9";
                    clicked => {
                        root.open-proxy();
                    }
                }

                SettingsRow {
                    label: @tr("About");
                    value: root.version;
                    tint: #8e6bd8;
                    icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v6M12 7.5v.5";
                    clicked => {
                        root.page = "about";
                    }
                }
            }

            if root.page == "main": SettingsCard {
                SettingsRow {
                    label: @tr("Passcode");
                    value: root.passcode-on ? @tr("On") : @tr("Off");
                    tint: #3fb27f;
                    icon: "M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5zM12 15v2";
                    clicked => {
                        root.page = "passcode";
                    }
                }
            }

            // ---- Код-пароль
            if root.page == "passcode": SettingsCard {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: root.passcode-on
                            ? @tr("Oxigram data on this computer is encrypted. It can't be read without the code; when locked, Oxigram disconnects from Telegram.")
                            : @tr("The passcode encrypts the session, API keys and chat cache on this computer (Argon2id and ChaCha20-Poly1305). The code is stored only by you: a forgotten code can't be recovered.");
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                        height: 72px;
                    }

                    if !root.passcode-on: VerticalLayout {
                        spacing: 8px;
                        pc-new := Field {
                            password: true;
                            placeholder: @tr("New passcode (at least 4 characters)");
                            enabled: !root.passcode-busy;
                        }

                        pc-repeat := Field {
                            password: true;
                            placeholder: @tr("Repeat passcode");
                            enabled: !root.passcode-busy;
                            accepted => {
                                root.passcode-enable(pc-new.text, pc-repeat.text);
                            }
                        }

                        Button {
                            text: @tr("Turn on passcode");
                            enabled: !root.passcode-busy;
                            clicked => {
                                root.passcode-enable(pc-new.text, pc-repeat.text);
                            }
                        }
                    }

                    if root.passcode-on: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            height: 36px;
                            Button {
                                kind: "ghost";
                                text: @tr("Auto-lock: {}", root.auto-lock-text);
                                clicked => {
                                    root.cycle-auto-lock();
                                }
                            }
                        }

                        Button {
                            text: @tr("Lock now (Ctrl+L)");
                            enabled: !root.passcode-busy;
                            clicked => {
                                root.lock-now();
                            }
                        }

                        Text {
                            text: @tr("Change passcode");
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 600;
                            height: 22px;
                            vertical-alignment: bottom;
                        }

                        pc-old := Field {
                            password: true;
                            placeholder: @tr("Current passcode");
                            enabled: !root.passcode-busy;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            pc-new2 := Field {
                                password: true;
                                placeholder: @tr("New passcode");
                                enabled: !root.passcode-busy;
                            }

                            pc-repeat2 := Field {
                                password: true;
                                placeholder: @tr("Repeat");
                                enabled: !root.passcode-busy;
                            }
                        }

                        Button {
                            kind: "ghost";
                            text: @tr("Change");
                            enabled: !root.passcode-busy;
                            clicked => {
                                root.passcode-change(pc-old.text, pc-new2.text, pc-repeat2.text);
                                pc-new2.text = "";
                                pc-repeat2.text = "";
                            }
                        }

                        Text {
                            text: @tr("Turn off");
                            color: Theme.danger;
                            font-size: 13px;
                            font-weight: 600;
                            height: 22px;
                            vertical-alignment: bottom;
                        }

                        pc-off := Field {
                            password: true;
                            placeholder: @tr("Current passcode");
                            enabled: !root.passcode-busy;
                        }

                        Button {
                            kind: "ghost";
                            text: @tr("Turn off passcode");
                            enabled: !root.passcode-busy;
                            clicked => {
                                root.passcode-disable(pc-off.text);
                            }
                        }
                    }

                    if root.passcode-status != "": Text {
                        text: root.passcode-status;
                        color: Theme.accent;
                        font-size: 13px;
                        wrap: word-wrap;
                        height: 36px;
                    }
                }
            }

            if root.page == "main": SettingsCard {
                SettingsRow {
                    label: @tr("Log Out");
                    danger: true;
                    tint: #e5534b;
                    icon: "M10 4H5v16h5M14 8l4 4-4 4M18 12H9";
                    clicked => {
                        root.sign-out();
                    }
                }
            }

            // ---- Toggle pages: the options of this group
            if root.page == "notifications" || root.page == "data" || root.page == "general": SettingsCard {
                for option in root.options: ToggleRow {
                    visible: option.group == root.page;
                    height: option.group == root.page ? self.preferred-height : 0;
                    option: option;
                    toggle(key) => {
                        root.toggle(key);
                    }
                }
            }

            if root.page == "general": SettingsCard {
                SettingsRow {
                    label: @tr("Language");
                    value: root.language-label;
                    tint: #4a90d9;
                    icon: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18";
                    clicked => {
                        root.cycle-language();
                    }
                }
                SettingsRow {
                    label: @tr("Text size");
                    value: root.text-size;
                    tint: #f0a33a;
                    icon: "M4 7V5h10v2M9 5v14M7 19h4M14 12v-1h6v1M17 11v8M16 19h2";
                    clicked => {
                        root.cycle-text-size();
                    }
                }
            }

            if root.page == "data": SettingsCard {
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    height: 64px;
                    Text {
                        text: @tr("Media cache: {}", root.cache-text);
                        color: Theme.text;
                        font-size: 15px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Button {
                        kind: "ghost";
                        text: @tr("Clear");
                        width: 110px;
                        clicked => {
                            root.clear-cache();
                        }
                    }
                }
            }

            if root.page == "about": SettingsCard {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "Oxigram " + root.version;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        height: 22px;
                    }

                    Text {
                        text: @tr("A lightweight Telegram client in Rust.");
                        color: Theme.dim;
                        font-size: 14px;
                        height: 20px;
                    }

                    Text {
                        text: @tr("You use your own API keys, stored only on this computer. You can change them after logging out.");
                        color: Theme.dim;
                        font-size: 14px;
                        wrap: word-wrap;
                        height: 60px;
                    }

                    Text {
                        text: "github.com/Timon2306/oxigram";
                        color: Theme.accent;
                        font-size: 14px;
                        height: 20px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-url("https://github.com/Timon2306/oxigram");
                            }
                        }
                    }


                    // Updates: the check, then "Обновить" and "Что нового".
                    Rectangle {
                        height: 8px;
                    }

                    Text {
                        text: root.update-status != "" ? root.update-status : @tr("Updates");
                        color: root.update-version != "" ? Theme.accent : Theme.dim;
                        font-size: 14px;
                        height: 20px;
                        overflow: elide;
                    }

                    if root.update-busy && root.update-progress > 0: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.input;
                        Rectangle {
                            x: 0;
                            width: parent.width * max(0, min(1, root.update-progress));
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        if root.update-version == "": Button {
                            kind: "ghost";
                            text: @tr("Check for updates");
                            enabled: !root.update-busy;
                            clicked => {
                                root.update-check();
                            }
                        }
                        if root.update-version != "": Button {
                            text: @tr("Update");
                            enabled: !root.update-busy;
                            clicked => {
                                root.update-install();
                            }
                        }
                        if root.update-version != "": Button {
                            kind: "ghost";
                            text: @tr("What's new");
                            clicked => {
                                root.update-notes();
                            }
                        }
                    }

                    Text {
                        text: @tr("MIT license © Timon2306");
                        color: Theme.dim;
                        font-size: 14px;
                        height: 20px;
                    }

                    Text {
                        text: "Made with Slint — slint.dev";
                        color: Theme.accent;
                        font-size: 14px;
                        height: 20px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-url("https://slint.dev");
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> window-title: "Oxigram";
    // Sign-in: where the code went, resending it, the QR code
    in property <string> code-hint;
    in property <string> resend-text;
    in property <bool> resend-ready;
    callback resend-code();
    in property <string> qr-path;
    in property <int> qr-size: 1;
    callback qr-start();
    // The phone step's country (see phone.rs)
    in property <string> phone-flag;
    in property <string> phone-dial;
    in property <string> phone-mask;
    in property <string> phone-country;
    in property <string> phone-text;
    in property <int> phone-text-bytes;
    in property <int> phone-text-serial;
    in-out property <bool> country-open;
    in property <[CountryItem]> country-items;
    callback phone-edited(string);
    callback country-filter(string);
    callback country-pick(int);
    // The interface language's label in the settings
    in property <string> language-label;
    callback cycle-language();
    // The local passcode
    in property <bool> passcode-on;
    in property <string> passcode-status;
    in property <bool> passcode-busy;
    in property <string> auto-lock-text;
    callback unlock(string);
    callback forgot-passcode();
    callback passcode-enable(string, string);
    callback passcode-change(string, string, string);
    callback passcode-disable(string);
    callback cycle-auto-lock();
    callback lock-now();
    // A newer release ("0.3.1"), the check's state, the download's progress
    in property <string> update-version;
    in property <string> update-status;
    in-out property <bool> update-busy;
    in property <float> update-progress;
    callback update-check();
    callback update-install();
    callback update-notes();
    // The badge: "О программе" in the settings
    callback open-update();
    title: root.window-title;
    icon: @image-url("../icons/32x32.png");
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 480px;
    // Flipped by Rust to repaint the whole window: the software renderer
    // redraws only changed areas, and a window shown again from the tray has
    // lost its old picture (it came back transparent until hovered).
    in property <bool> repaint-flip;
    background: root.repaint-flip ? Theme.bg.darker(0.01) : Theme.bg;
    default-font-family: "Open Sans";
    default-font-size: 15px;

    // Login
    in property <string> stage: "loading";
    in property <string> login-phone;
    in property <string> login-hint;
    in property <string> error;
    in property <bool> busy;
    in property <bool> keys-rejected;
    callback save-keys(string, string);
    callback request-code(string);
    callback submit-code(string);
    callback submit-password(string);
    callback back-to-phone();
    callback change-keys();

    // Dialog list
    in property <[DialogItem]> dialogs;
    in property <bool> online: true;
    in property <bool> show-archive;
    in property <int> archived-count;
    in property <string> archived-label;
    callback open-chat(int);
    callback filter-dialogs(string);
    callback load-more-dialogs();
    callback toggle-archive();
    // A row became visible and wants its photo.
    callback want-avatar(int);

    // Open chat
    in property <bool> chat-open;
    in property <string> chat-title;
    in property <string> chat-initial;
    in property <color> chat-color;
    in property <image> chat-photo;
    in property <bool> chat-has-photo;
    in property <bool> chat-saved;
    in property <string> chat-subtitle;
    in property <bool> chat-subtitle-accent;
    in property <string> chat-error;
    in property <[MessageItem]> messages;
    in property <bool> history-loading;
    in-out property <bool> stick-bottom: true;
    callback load-older();
    callback send-text(string);
    // False in a channel the user cannot post in: no composer, a mute switch.
    in property <bool> chat-can-post: true;
    // "Подписаться" / "Вступить" for a found chat not joined; empty otherwise
    in property <string> chat-join;
    callback join-chat();
    // The one message whose text is selectable right now (see MessageView).
    in-out property <int> selecting-id: -1;
    in property <bool> chat-muted;
    callback toggle-mute();
    // A forum: the chat is split into topics, the header offers the list.
    in property <bool> chat-forum;
    in property <bool> topics-open;
    in property <bool> topic-open;
    in property <string> topic-title;
    in property <[TopicItem]> topic-items;
    callback open-topics();
    callback pick-topic(int);
    callback close-topic();

    // Chat folders (tabs above the list); index 0 is "Все чаты"
    in property <[FolderTab]> folder-tabs;
    // The list shows the main chats (the archive row belongs to it)
    in property <bool> folder-all: true;
    callback pick-folder(int);

    // Unsent text of the open chat; Rust keeps it per chat
    in-out property <string> composer-text <=> composer.text;
    callback composer-changed(string);

    // Contacts window
    in-out property <bool> contacts-open;
    in property <[ContactItem]> contacts-items;
    // "Загрузка…", "Контактов нет"… shown when the list is empty
    in property <string> contacts-note;
    callback open-contacts();
    callback contacts-filter(string);
    callback contacts-pick(int);
    callback contacts-avatar(int);

    // Profile column of the open chat
    in-out property <bool> info-open;
    in property <bool> info-loading;
    in property <string> info-error;
    in property <string> info-title;
    in property <string> info-subtitle;
    in property <string> info-initial;
    in property <color> info-color;
    in property <image> info-photo;
    in property <bool> info-has-photo;
    in property <bool> info-saved;
    in property <bool> info-can-mute;
    in property <[ProfileLine]> info-lines;
    callback open-info();
    // Wide windows keep the column beside the chat; narrow ones draw it over the chat
    property <length> info-width: min(340px, root.width);
    // (docked only while the chat beside it keeps 480 px: list 341 + chat + 340)
    property <bool> info-docked: root.width >= 1161px;

    // Context menus
    callback dialog-menu(int, length, length);
    callback message-menu(int, length, length);
    in property <[MenuEntry]> menu-items;
    in-out property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;
    callback menu-pick(string);
    // Quick reactions on top of a message's menu, the own one marked
    in property <[string]> menu-reactions;
    in property <string> menu-reaction-mine;
    callback menu-react(string);
    callback react(int, string);
    callback want-emoji(string);
    // The widest bubble changed (window resized): reaction rows rewrap.
    callback reaction-width(length);
    // Look and hotkeys
    in property <string> text-size-label: @tr("Normal");
    callback cycle-text-size();
    callback next-chat(bool);
    callback edit-last();
    // Selection of several messages
    in property <bool> select-mode;
    in property <int> selected-count;
    in property <bool> select-can-delete;
    callback pick-message(int);
    callback select-forward();
    callback select-delete();
    callback select-cancel();

    // Reply / edit bar above the composer: mode "", "reply" or "edit"
    in property <string> bar-mode;
    in property <string> bar-title;
    in property <string> bar-text;
    callback bar-cancel();

    // Burger menu
    in-out property <bool> drawer-open;
    in property <string> me-name;
    in property <string> me-phone;
    in property <string> me-initial;
    in property <color> me-color;
    in property <image> me-photo;
    in property <bool> me-has-photo;
    in property <string> version;
    callback open-saved();
    callback reload-dialogs();
    callback open-settings();

    // Memory saver
    in property <[SaverOption]> saver-options;
    in-out property <bool> saver-open;
    callback open-saver();
    callback saver-toggle(string);

    // Settings
    in-out property <bool> settings-open;
    // "main", "notifications", "data", "general" or "about"
    in-out property <string> settings-page: "main";
    in property <string> me-username;
    in property <string> me-account;
    in property <string> cache-text;
    callback clear-cache();
    callback ask-sign-out();

    // Confirmation for destructive actions
    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    // A checkbox ("Удалить также у собеседника"), hidden when empty
    in property <string> confirm-check;
    in-out property <bool> confirm-checked;
    callback confirm-done(bool);

    // Forward picker
    in-out property <bool> forward-open;
    in property <[DialogItem]> forward-items;
    callback forward-filter(string);
    callback forward-pick(int);

    // A short note at the bottom ("Текст скопирован")
    in property <string> toast;

    // Sending files (native/src/sending.rs): the clip, the send window, the
    // progress pill and the drop hint.
    callback attach();
    callback send-remove(int);
    callback send-go(string, bool);
    callback send-cancel();
    callback send-abort();
    // True when the clipboard held pictures or files, which are now staged.
    callback paste-files() -> bool;
    // Sends a Ctrl shortcut of another layout again as its Latin letter; false if none.
    callback latin-shortcut(string) -> bool;
    in-out property <bool> send-open;
    in property <[SendItem]> send-items;
    // "2 файла" and whether the single file is a picture, for the title
    in property <string> send-count-text;
    in property <int> send-count;
    in property <bool> send-single-picture;
    in property <bool> send-has-pictures;
    in-out property <bool> send-compress: true;
    in property <bool> sending-active;
    in property <string> sending-text;
    in property <float> sending-progress;
    in property <bool> drop-hover;

    // Copies through a hidden text field: Slint has no clipboard API.
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }
    public function scroll-dialogs-top() {
        dialog-list.content-y = 0;
    }
    public function focus-composer() {
        composer.focus();
    }

    // Rust clears the composer after a send; on failure the text comes back.
    public function set-composer(text: string) {
        composer.text = text;
    }
    // To the end of the estimated content. The ListView estimates the total
    // height from the rows it has measured, so the estimate settles over a
    // few frames; the content-height handler below repeats this while the
    // view sticks to the bottom. (Seeking far past the end can leave only the
    // last row drawn, at the top.)
    public function scroll-to-bottom() {
        root.stick-bottom = true;
        root.settle-frames = 60;
        root.stable-frames = 0;
        history.content-y = min(0px, history.visible-height - history.content-height);
    }
    // Frames left in which the bottom is re-applied while the ListView's
    // height estimate settles. Only after an explicit scroll to the bottom:
    // re-applying it on every estimate change fought the user's own
    // scrolling and made the list jerk.
    // It stops once the estimate has held for three ticks (at most ~1 s):
    // tall channel posts take a while to be measured.
    // Slint scrolls a whole wheel notch in one frame, which reads as jerky.
    // Each notch adds to the distance still to go, and every rendered frame
    // covers a share of it that depends on the frame time (half of it every
    // 35 ms). Spinning the wheel keeps the motion going without the stops
    // ("steps") that restarting an ease-out animation per notch produced.
    // Relative steps, not a target position: the ListView re-anchors its
    // content-y while it measures rows, and a fixed target would fight that.
    property <length> wheel-pending;
    property <duration> wheel-last;
    // Reading animation-tick() makes this change on every frame, but only
    // while there is distance left; otherwise the window stays idle.
    property <duration> wheel-clock: abs(root.wheel-pending) > 0.5px ? animation-tick() : 0ms;
    public function smooth-scroll(dy: length) {
        root.settle-frames = 0;
        root.wheel-pending += dy;
    }
    changed wheel-clock => {
        if (root.wheel-clock == 0ms) {
            root.wheel-last = 0ms;
        } else {
            let dt = root.wheel-last == 0ms ? 16ms : max(1ms, min(50ms, root.wheel-clock - root.wheel-last));
            root.wheel-last = root.wheel-clock;
            let share = 1 - pow(0.5, (dt / 1ms) / 35);
            let step = abs(root.wheel-pending) < 1px ? root.wheel-pending : root.wheel-pending * share;
            let lowest = min(0px, history.visible-height - history.content-height);
            let wanted = history.content-y + step;
            history.content-y = max(lowest, min(0px, wanted));
            // At an end the rest of the motion is dropped. Only a real end:
            // the list also shifts content-y itself when a row with a big
            // picture turns out taller than its estimate.
            root.wheel-pending = wanted > 0px || wanted < lowest ? 0px : root.wheel-pending - step;
        }
    }

    // OXIGRAM_BENCH: scrolls the open chat up by itself, to measure the
    // frame rate of scrolling (with SLINT_DEBUG_PERFORMANCE).
    in property <bool> bench;
    Timer {
        interval: 16ms;
        running: root.bench && root.chat-open;
        triggered => {
            history.content-y = history.content-y + 8px;
        }
    }
    property <int> settle-frames;
    property <int> stable-frames;
    property <length> settled-height;
    settle := Timer {
        interval: 16ms;
        running: root.settle-frames > 0;
        triggered => {
            if (abs(history.content-height - root.settled-height) < 1px) {
                root.stable-frames += 1;
            } else {
                root.stable-frames = 0;
                root.settled-height = history.content-height;
            }
            history.content-y = min(0px, history.visible-height - history.content-height);
            root.settle-frames = root.stable-frames >= 3 ? 0 : root.settle-frames - 1;
        }
    }

    callback close-chat();

    // ---- Search inside the open chat (Ctrl+F)
    in-out property <bool> search-open;
    // The results list under the bar; hidden after a pick to show the chat.
    in-out property <bool> search-list-open;
    in property <[SearchHit]> search-hits;
    // "Найдено: 12", "3 из 12", "…" or "Ничего не найдено"
    in property <string> search-count;
    // Query, true when Enter asked for it at once (else after a pause).
    callback chat-search(string, bool);
    callback search-pick(int);
    // +1 goes to an older hit, -1 to a newer one.
    callback search-step(int);
    callback search-close();
    // Messages after the loaded window are not loaded: the way back.
    in property <bool> detached;
    callback jump-latest();
    public function open-search() {
        root.search-open = true;
        root.search-list-open = true;
        search-field.focus();
    }
    public function close-search() {
        root.search-open = false;
        root.search-close();
        if (root.chat-can-post) {
            composer.focus();
        } else {
            keys.focus();
        }
    }
    public function clear-search-field() {
        search-field.text = "";
    }
    // A click on a #hashtag: search it in this chat.
    public function search-in-chat(text: string) {
        root.open-search();
        search-field.text = text;
        root.chat-search(text, true);
    }

    // ---- Jump to a message: the row index, and its ID for the highlight.
    in-out property <int> jump-id: -1;
    property <int> jump-row;
    property <int> jump-frames;
    property <bool> jump-seen;
    property <int> jump-calm;
    in-out property <int> highlight-id: -1;
    public function jump-to(row: int, id: int) {
        root.settle-frames = 0;
        root.wheel-pending = 0px;
        root.stick-bottom = false;
        root.jump-row = row;
        root.jump-id = id;
        root.jump-seen = false;
        root.jump-calm = 0;
        root.jump-frames = 90;
        root.highlight-id = id;
    }
    // Until the row exists, aim by the estimate; the row then centres itself.
    Timer {
        interval: 16ms;
        running: root.jump-frames > 0 && !root.jump-seen;
        triggered => {
            let n = max(1, root.messages.length);
            let lowest = min(0px, history.visible-height - history.content-height);
            let wanted = -history.content-height * root.jump-row / n + history.visible-height / 2;
            history.content-y = max(lowest, min(0px, wanted));
            root.jump-frames -= 1;
        }
    }
    Timer {
        interval: 1800ms;
        running: root.highlight-id >= 0 && root.jump-frames <= 0;
        triggered => {
            root.highlight-id = -1;
        }
    }

    // ---- Global search in the chat list: chats by @username and messages
    in property <[DialogItem]> found-chats;
    in property <[DialogItem]> found-messages;
    // "Поиск сообщений…" / "Ничего не найдено" under the results
    in property <string> found-note;
    callback global-search(string);
    callback open-found-chat(int);
    callback open-found-message(int);
    callback want-found-avatar(int, bool);

    // Proxy window
    callback open-proxy();
    callback proxy-check();
    callback proxy-save();
    in-out property <bool> proxy-open;
    in-out property <bool> proxy-enabled;
    in-out property <string> proxy-kind: "socks5";
    in-out property <string> proxy-host;
    in-out property <string> proxy-port;
    in-out property <string> proxy-user;
    in-out property <string> proxy-pass;
    in property <string> proxy-status;
    in property <bool> proxy-status-ok;
    in property <bool> proxy-busy;
    // "Выключен" / "SOCKS5 · host:port", in the settings
    in property <string> proxy-summary: @tr("Disabled");

    // Pictures and the full-window viewer
    callback want-picture(int);
    callback open-picture(int);
    // File cards: download, cancel or open
    callback file-click(int);
    // Links in message text
    callback open-link(string);
    // The quote of a reply: jump to the answered message
    callback open-reply(int);
    // Inline buttons under messages
    callback press-button(int, int, int);
    // The comments of a channel post: open its discussion group
    callback open-discussion(int);
    callback viewer-close();
    callback viewer-save();
    callback viewer-menu(length, length);
    // Video in the viewer
    in property <bool> viewer-video;
    in property <bool> viewer-playing;
    in-out property <bool> viewer-muted;
    in property <float> viewer-progress;
    in property <string> viewer-time;
    callback viewer-toggle-play();
    callback viewer-seek(float);
    callback viewer-toggle-mute();
    // Esc must reach the window's key handler even when a text field had focus.
    public function focus-keys() {
        keys.focus();
    }
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <bool> viewer-has-image;
    // The size the picture is drawn at, in logical px: Rust sets it to the
    // decoded size, so the renderer never has to scale (which looks soft).
    in property <length> viewer-image-width;
    in property <length> viewer-image-height;
    // "Загрузка…", "1,2 МБ из 3 МБ", or an error
    in property <string> viewer-status;
    // "Сохранить" / "Показать в папке"; empty hides the button
    in property <string> viewer-save-text;

    // Esc peels one layer at a time, as in Telegram Desktop: an open menu or
    // dialog, the reply/edit strip, then the open chat.
    forward-focus: keys;
    keys := FocusScope {
        width: root.width;
        height: root.height;
        capture-key-pressed(event) => {
            // Space pauses a video in the viewer.
            if (event.text == " " && root.viewer-open && root.viewer-video) {
                root.viewer-toggle-play();
                return accept;
            }
            // Ctrl+C / X / V / A / Z in another layout ("м" for "v" in the Russian
            // one) or as a control character (U+0016 on some systems): Slint's
            // text fields know only the Latin letters, so the key is sent again
            // as its Latin letter.
            if ((event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt && root.latin-shortcut(event.text)) {
                return accept;
            }
            // Ctrl+L locks with the passcode ("д" in the Russian layout, or
            // the control character U+000C).
            if ((event.text == "l" || event.text == "L" || event.text == "д" || event.text == "Д" || event.text == "\u{c}") && (event.modifiers.control || event.modifiers.meta) && root.stage == "ready") {
                root.lock-now();
                return accept;
            }
            // Ctrl+V of pictures or files from the clipboard (text pastes as usual).
            if ((event.text == "v" || event.text == "V") && (event.modifiers.control || event.modifiers.meta) && root.paste-files()) {
                return accept;
            }
            // Ctrl+F searches in the open chat ("а" in the Russian layout, or
            // the control character U+0006 on some systems).
            if ((event.text == "f" || event.text == "F" || event.text == "а" || event.text == "А" || event.text == "\u{6}") && (event.modifiers.control || event.modifiers.meta) && root.chat-open) {
                root.open-search();
                return accept;
            }
            // Ctrl+Tab / Ctrl+Shift+Tab: next / previous chat, as in Telegram Desktop.
            if ((event.text == Key.Tab || event.text == Key.Backtab) && event.modifiers.control) {
                root.next-chat(!(event.modifiers.shift || event.text == Key.Backtab));
                return accept;
            }
            // Up in an empty field edits the last own text message.
            if (event.text == Key.UpArrow && root.chat-open && root.chat-can-post && root.bar-mode == "" && !root.select-mode && composer.has-focus && composer.text == "") {
                root.edit-last();
                return accept;
            }
            if (event.text != Key.Escape) {
                return reject;
            }
            if (root.menu-open) {
                root.menu-open = false;
            } else if (root.send-open) {
                root.send-cancel();
            } else if (root.viewer-open && root.viewer-video && event.text == " ") {
                root.viewer-toggle-play();
            } else if (root.viewer-open) {
                root.viewer-close();
            } else if (root.proxy-open) {
                root.proxy-open = false;
            } else if (root.confirm-open) {
                root.confirm-done(false);
            } else if (root.forward-open) {
                root.forward-open = false;
            } else if (root.contacts-open) {
                root.contacts-open = false;
            } else if (root.settings-open && root.settings-page != "main") {
                root.settings-page = "main";
            } else if (root.settings-open) {
                root.settings-open = false;
            } else if (root.drawer-open) {
                root.drawer-open = false;
            } else if (root.select-mode) {
                root.select-cancel();
            } else if (root.bar-mode != "") {
                root.bar-cancel();
            } else if (root.search-open) {
                root.close-search();
            } else if (root.info-open) {
                root.info-open = false;
            } else if (root.chat-open) {
                root.close-chat();
            } else {
                return reject;
            }
            accept
        }

    if root.stage != "ready": LoginCard {
        stage: root.stage;
        code-hint: root.code-hint;
        resend-text: root.resend-text;
        resend-ready: root.resend-ready;
        resend-code => {
            root.resend-code();
        }
        qr-path: root.qr-path;
        qr-size: root.qr-size;
        qr-start => {
            root.qr-start();
        }
        phone-flag: root.phone-flag;
        phone-dial: root.phone-dial;
        phone-mask: root.phone-mask;
        phone-country: root.phone-country;
        phone-text: root.phone-text;
        phone-text-bytes: root.phone-text-bytes;
        phone-text-serial: root.phone-text-serial;
        country-open <=> root.country-open;
        country-items: root.country-items;
        phone-edited(text) => {
            root.phone-edited(text);
        }
        country-filter(text) => {
            root.country-filter(text);
        }
        country-pick(index) => {
            root.country-pick(index);
        }
        phone: root.login-phone;
        hint: root.login-hint;
        error: root.error;
        busy: root.busy;
        keys-rejected: root.keys-rejected;
        save-keys(id, hash) => {
            root.save-keys(id, hash);
        }
        request-code(phone) => {
            root.request-code(phone);
        }
        submit-code(code) => {
            root.submit-code(code);
        }
        submit-password(password) => {
            root.submit-password(password);
        }
        back-to-phone => {
            root.back-to-phone();
        }
        unlock(passcode) => {
            root.unlock(passcode);
        }
        forgot-passcode => {
            root.forgot-passcode();
        }
        change-keys => {
            root.change-keys();
        }
        open-proxy => {
            root.open-proxy();
        }
    }

    HorizontalLayout {
        visible: root.stage == "ready";

        // ---- Left pane: search and chats
        Rectangle {
            width: 340px;
            background: Theme.raised;
            VerticalLayout {
                HorizontalLayout {
                    height: 52px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: stretch;
                    if !root.show-archive: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: burger-touch.has-hover ? Theme.hover : transparent;
                            burger-touch := TouchArea {
                                clicked => {
                                    root.drawer-open = true;
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                commands: "M4 7h16M4 12h16M4 17h16";
                            }
                            // A newer version is out: a quiet dot.
                            if root.update-version != "": Rectangle {
                                x: parent.width - 11px;
                                y: 6px;
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: Theme.accent;
                            }
                        }
                    }
                    // "↑ 0.3.1": opens "О программе" with the update.
                    if !root.show-archive && root.update-version != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: update-label.preferred-width + 14px;
                            height: 22px;
                            border-radius: 11px;
                            background: update-touch.has-hover ? #2b5278 : #2b527888;
                            update-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-update();
                                }
                            }
                            update-label := Text {
                                text: "↑ " + root.update-version;
                                color: Theme.accent;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.show-archive: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: back-touch.has-hover ? Theme.hover : transparent;
                            back-touch := TouchArea {
                                clicked => {
                                    root.toggle-archive();
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                commands: "M15 5l-7 7 7 7";
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 34px;
                            border-radius: 17px;
                            background: Theme.input;
                            border-width: 1px;
                            border-color: search.has-focus ? Theme.accent : transparent;
                            if search.text == "": Text {
                                x: 14px;
                                height: parent.height;
                                text: root.show-archive ? @tr("Search in archive") : @tr("Search");
                                color: Theme.dim;
                                vertical-alignment: center;
                            }
                            search := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                vertical-alignment: center;
                                single-line: true;
                                color: Theme.text;
                                selection-background-color: #4a7bb7;
                                edited => {
                                    root.filter-dialogs(self.text);
                                    root.global-search(self.text);
                                }
                            }
                        }
                    }
                }

                if !root.online: Rectangle {
                    background: #4a3a17;
                    height: 26px;
                    Text {
                        text: @tr("No connection, reconnecting…");
                        color: #f1d38a;
                        font-size: 12px;
                    }
                }
                if root.folder-tabs.length > 1 && !root.show-archive && search.text == "": FolderTabs {
                    tabs: root.folder-tabs;
                    pick(index) => {
                        root.pick-folder(index);
                    }
                }
                if root.archived-count > 0 && !root.show-archive && root.folder-all && search.text == "": ArchiveRow {
                    label: root.archived-label;
                    clicked => {
                        root.toggle-archive();
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                dialog-list := ListView {
                    visible: search.text == "";
                    width: parent.width;
                    height: parent.height;
                    for item[index] in root.dialogs: DialogRow {
                        item: item;
                        init => {
                            if (!item.has-photo) {
                                root.want-avatar(index);
                            }
                        }
                        clicked => {
                            root.open-chat(index);
                        }
                        context(x, y) => {
                            root.dialog-menu(index, x, y);
                        }
                    }
                    changed content-y => {
                        if (-self.content-y + self.visible-height > self.content-height - 400px) {
                            root.load-more-dialogs();
                        }
                    }
                }
                // While searching: chats by name, then by @username, then messages.
                if search.text != "": Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-height: results.preferred-height;
                    results := VerticalLayout {
                        y: 0;
                        width: parent.width;
                        alignment: start;
                    if search.text != "" && (root.dialogs.length > 0 || root.found-chats.length > 0): Rectangle {
                        height: 28px;
                        Text {
                            x: 14px;
                            text: @tr("Chats");
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    for item[index] in root.dialogs: DialogRow {
                        item: item;
                        init => {
                            if (!item.has-photo) {
                                root.want-avatar(index);
                            }
                        }
                        clicked => {
                            root.open-chat(index);
                        }
                        context(x, y) => {
                            root.dialog-menu(index, x, y);
                        }
                    }
                    if search.text != "" && root.found-chats.length > 0: Rectangle {
                        height: 28px;
                        Text {
                            x: 14px;
                            text: @tr("Global search");
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    for item[index] in root.found-chats: DialogRow {
                        item: item;
                        init => {
                            if (!item.has-photo) {
                                root.want-found-avatar(index, true);
                            }
                        }
                        clicked => {
                            root.open-found-chat(index);
                        }
                    }
                    if search.text != "" && root.found-messages.length > 0: Rectangle {
                        height: 28px;
                        Text {
                            x: 14px;
                            text: @tr("Messages");
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    for item[index] in root.found-messages: DialogRow {
                        item: item;
                        init => {
                            if (!item.has-photo) {
                                root.want-found-avatar(index, false);
                            }
                        }
                        clicked => {
                            root.open-found-message(index);
                        }
                    }
                    if search.text != "" && root.found-note != "": Rectangle {
                        height: 44px;
                        Text {
                            text: root.found-note;
                            color: Theme.dim;
                            font-size: 13px;
                        }
                    }
                    }
                }
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // ---- Right pane: the open chat
        Rectangle {
            horizontal-stretch: 1;
            // Whatever the chat holds, it never pushes the window wider than
            // it is (that shoved the chat list off the left edge).
            min-width: 0px;
            background: @linear-gradient(180deg, Theme.chat-top 0%, Theme.chat-bottom 100%);
            clip: true;
            // No radial glows as in the WebView's --chat-bg: the software
            // renderer computes gradients per pixel on every frame, and the two
            // glows alone pushed a scrolling frame from under 16 ms to ~20 ms.
            Image {
                width: parent.width;
                height: parent.height;
                source: @image-url("pattern.svg");
                colorize: Theme.pattern-tint;
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
            }

            if !root.chat-open: VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Pill {
                        text: @tr("Select a chat");
                    }
                }
            }
            VerticalLayout {
                visible: root.chat-open;
                // Pinned to the left edge: with a width of its own and no x,
                // Slint would centre it in the pane.
                x: 0;
                width: parent.width - (root.info-open && root.info-docked ? root.info-width : 0px);
                Rectangle {
                    height: 52px;
                    background: Theme.raised;
                    // The topic list of a forum, left of the magnifier.
                    if root.chat-forum: Rectangle {
                        x: parent.width - 92px;
                        y: 8px;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        z: 5;
                        background: topics-touch.has-hover ? Theme.hover : transparent;
                        topics-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-topics();
                            }
                        }
                        StrokeIcon {
                            x: 8px;
                            y: 8px;
                            stroke-width: 2px;
                            commands: "M4 6h16M4 12h16M4 18h16";
                        }
                    }
                    // The magnifier at the right edge searches the chat.
                    Rectangle {
                        x: parent.width - 48px;
                        y: 8px;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        z: 5;
                        background: mag-touch.has-hover ? Theme.hover : transparent;
                        mag-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-search();
                            }
                        }
                        StrokeIcon {
                            stroke-width: 2px;
                            commands: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4";
                        }
                    }
                    // The header opens the profile column.
                    header-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-info();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            if root.topic-open: Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: topic-back.has-hover ? Theme.hover : transparent;
                                topic-back := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.close-topic();
                                    }
                                }
                                StrokeIcon {
                                    x: 8px;
                                    y: 8px;
                                    stroke-width: 2px;
                                    commands: "M15 5l-7 7 7 7";
                                }
                            }
                            if !root.topic-open: Avatar {
                                size: 36px;
                                initial: root.chat-initial;
                                tint: root.chat-color;
                                photo: root.chat-photo;
                                has-photo: root.chat-has-photo;
                                saved: root.chat-saved;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.topic-open ? root.topic-title : root.chat-title;
                                color: Theme.text;
                                font-weight: 600;
                                font-size: 15px;
                                overflow: elide;
                            }

                            if root.chat-subtitle != "" || root.chat-error != "": Text {
                                text: root.chat-error != "" ? root.chat-error : root.chat-subtitle;
                                color: root.chat-error != "" ? Theme.danger : root.chat-subtitle-accent ? Theme.accent : Theme.dim;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }

                    // Selection mode: the header becomes the actions bar.
                    if root.select-mode: Rectangle {
                        background: Theme.raised;
                        TouchArea { }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            Text {
                                text: @tr("Selected: {}", root.selected-count);
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Button {
                                kind: "ghost";
                                text: @tr("Forward");
                                width: 120px;
                                clicked => {
                                    root.select-forward();
                                }
                            }

                            if root.select-can-delete: DangerButton {
                                text: @tr("Delete");
                                clicked => {
                                    root.select-delete();
                                }
                            }

                            Button {
                                kind: "ghost";
                                text: @tr("Cancel");
                                width: 100px;
                                clicked => {
                                    root.select-cancel();
                                }
                            }
                        }
                    }
                }

                // The search bar (Ctrl+F or the magnifier) and its results.
                Rectangle {
                    height: root.search-open ? 48px : 0px;
                    clip: true;
                    background: Theme.raised;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 17px;
                            background: Theme.input;
                            border-width: 1px;
                            border-color: search-field.has-focus ? Theme.accent : transparent;
                            if search-field.text == "": Text {
                                x: 14px;
                                height: parent.height;
                                text: @tr("Search in chat");
                                color: Theme.dim;
                                vertical-alignment: center;
                            }
                            search-field := TextInput {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                vertical-alignment: center;
                                single-line: true;
                                color: Theme.text;
                                selection-background-color: #4a7bb7;
                                edited => {
                                    root.search-list-open = true;
                                    root.chat-search(self.text, false);
                                }
                                accepted => {
                                    root.search-list-open = true;
                                    root.chat-search(self.text, true);
                                }
                            }
                        }
                        Text {
                            width: 130px;
                            text: root.search-count;
                            color: Theme.dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 32px;
                            border-radius: 16px;
                            background: up-touch.has-hover ? Theme.hover : transparent;
                            up-touch := TouchArea {
                                clicked => {
                                    root.search-step(1);
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                size: 18px;
                                commands: "M6 15l6-6 6 6";
                            }
                        }
                        Rectangle {
                            width: 32px;
                            border-radius: 16px;
                            background: dn-touch.has-hover ? Theme.hover : transparent;
                            dn-touch := TouchArea {
                                clicked => {
                                    root.search-step(-1);
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                size: 18px;
                                commands: "M6 9l6 6 6-6";
                            }
                        }
                        Rectangle {
                            width: 32px;
                            border-radius: 16px;
                            background: sx-touch.has-hover ? Theme.hover : transparent;
                            sx-touch := TouchArea {
                                clicked => {
                                    root.close-search();
                                }
                            }
                            StrokeIcon {
                                stroke-width: 2px;
                                size: 18px;
                                commands: "M6 6l12 12M18 6L6 18";
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                if root.search-open && root.search-list-open && root.search-hits.length > 0: Rectangle {
                    height: min(root.search-hits.length, 4) * 56px;
                    background: Theme.raised;
                    ListView {
                        for hit[index] in root.search-hits: Rectangle {
                            height: 56px;
                            background: hit-touch.has-hover ? Theme.hover : transparent;
                            hit-touch := TouchArea {
                                clicked => {
                                    root.search-pick(index);
                                }
                            }
                            // Fixed-height single lines: no wrapped text here.
                            Text {
                                x: 16px;
                                y: 8px;
                                width: parent.width - 100px;
                                height: 18px;
                                text: hit.who;
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                x: parent.width - 84px;
                                y: 8px;
                                width: 70px;
                                height: 18px;
                                text: hit.date;
                                color: Theme.dim;
                                font-size: 12px;
                                horizontal-alignment: right;
                            }
                            Text {
                                x: 16px;
                                y: 28px;
                                width: parent.width - 32px;
                                height: 20px;
                                text: hit.text;
                                color: Theme.text;
                                font-size: 14px;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    // Virtualized: only the bubbles on screen (plus a margin)
                    // exist, however much history is loaded. Heights vary, so
                    // the ListView estimates the total from the average row.
                    history := ListView {
                        // A short chat sits at the bottom, as in Telegram. The
                        // lift is assigned in the handlers below rather than
                        // bound, since the content height depends on the
                        // list's own height.
                        property <length> lift;
                        property <length> room: parent.height;
                        y: self.lift;
                        width: parent.width;
                        height: self.room - self.lift;
                        // An empty list is never lifted: at zero height it would
                        // create no rows and stay empty.
                        changed content-height => {
                            self.lift = self.content-height > 0 ? max(0px, self.room - self.content-height) : 0;
                        }
                        changed room => {
                            self.lift = self.content-height > 0 ? max(0px, self.room - self.content-height) : 0;
                            if (root.stick-bottom) {
                                root.scroll-to-bottom();
                            }
                        }
                        changed content-y => {
                            root.stick-bottom = self.content-y <= self.visible-height - self.content-height + 24px;
                            // Older pages are asked for a screen and a half ahead,
                            // so rows land above the visible ones and the view
                            // keeps its place.
                            if (self.content-y > -1.5 * self.visible-height && !root.history-loading) {
                                root.load-older();
                            }
                        }
                        // On a wide window the conversation stays a readable
                        // column in the middle, as in Telegram Desktop.
                        property <length> column-width: min(Theme.column, self.visible-width);
                        // The widest bubble; Rust wraps reaction chips to it.
                        property <length> bubble-max: min(520px, (self.column-width - 32px) * 0.74);
                        init => {
                            root.reaction-width(self.bubble-max);
                        }
                        changed bubble-max => {
                            root.reaction-width(self.bubble-max);
                        }
                        property <length> side: (self.visible-width - self.column-width) / 2 + 16px;
                        for m[index] in root.messages: rowbox := Rectangle {
                            height: row.preferred-height;
                            // A picked row is tinted across the whole width, as in Telegram.
                            background: m.selected ? #2b527866 : root.highlight-id == m.id ? #5ea5e84d : transparent;
                            // The message jumped to: centre it once it exists
                            // (the first aim is only an estimate).
                            Timer {
                                interval: 16ms;
                                running: root.jump-id == m.id && root.jump-frames > 0;
                                triggered => {
                                    root.jump-seen = true;
                                    let lowest = min(0px, history.visible-height - history.content-height);
                                    let aim = rowbox.height >= history.visible-height ? 8px : (history.visible-height - rowbox.height) / 2;
                                    let diff = history.absolute-position.y + aim - rowbox.absolute-position.y;
                                    if (abs(diff) < 2px) {
                                        root.jump-calm += 1;
                                    } else {
                                        root.jump-calm = 0;
                                        history.content-y = max(lowest, min(0px, history.content-y + diff));
                                    }
                                    root.jump-frames = root.jump-calm >= 6 ? 0 : root.jump-frames - 1;
                                }
                            }
                            // The wheel over a row scrolls smoothly (see smooth-scroll).
                            TouchArea {
                                clicked => {
                                    if (root.select-mode && !m.hidden) {
                                        root.pick-message(m.id);
                                    }
                                }
                                scroll-event(event) => {
                                    root.smooth-scroll(event.delta-y);
                                    accept
                                }
                            }
                            row := HorizontalLayout {
                                width: parent.width;
                                padding-left: history.side;
                                padding-right: history.side;
                                padding-top: index == 0 ? 10px : 0;
                                padding-bottom: index == root.messages.length - 1 ? 12px : 0;
                                MessageView {
                                    m: m;
                                    max-bubble: min(520px, (history.column-width - 32px) * 0.74);
                                    context(x, y) => {
                                        root.message-menu(m.id, x, y);
                                    }
                                    wheel(dy) => {
                                        root.smooth-scroll(dy);
                                    }
                                    selecting: root.selecting-id == m.id;
                                    stop-select => {
                                        root.selecting-id = -1;
                                    }
                                    want-picture(id) => {
                                        root.want-picture(id);
                                    }
                                    open-picture(id) => {
                                        root.open-picture(id);
                                    }
                                    file-click(id) => {
                                        root.file-click(id);
                                    }
                                    open-link(link) => {
                                        root.open-link(link);
                                    }
                                    open-reply(id) => {
                                        root.open-reply(id);
                                    }
                                    press-button(id, r, c) => {
                                        root.press-button(id, r, c);
                                    }
                                    open-discussion(id) => {
                                        root.open-discussion(id);
                                    }
                                    react(message, key) => {
                                        root.react(message, key);
                                    }
                                    want-emoji(id) => {
                                        root.want-emoji(id);
                                    }
                                    select-mode: root.select-mode;
                                    pick(id) => {
                                        root.pick-message(id);
                                    }
                                }
                            }
                        }
                    }

                    if !root.stick-bottom || root.detached: Rectangle {
                        x: parent.width - 56px;
                        y: parent.height - 52px;
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: down-touch.has-hover ? Theme.hover : Theme.raised;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000060;
                        down-touch := TouchArea {
                            clicked => {
                                if (root.detached) {
                                    root.jump-latest();
                                } else {
                                    root.scroll-to-bottom();
                                }
                            }
                        }
                        StrokeIcon {
                            stroke-width: 2px;
                            commands: "M6 9l6 6 6-6";
                        }
                    }
                }

                // A found public channel or group the user is not in.
                if root.chat-join != "": Rectangle {
                    height: 48px;
                    background: join-touch.has-hover ? Theme.hover : Theme.raised;
                    join-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.join-chat();
                        }
                    }
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    Text {
                        text: root.chat-join;
                        color: Theme.accent;
                        font-weight: 600;
                    }
                }

                // A channel the user cannot post in: a mute switch, as in Telegram.
                if !root.chat-can-post && root.chat-join == "": Rectangle {
                    height: 48px;
                    background: mute-touch.has-hover ? Theme.hover : Theme.raised;
                    mute-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-mute();
                        }
                    }
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    Text {
                        text: root.chat-muted ? @tr("Unmute") : @tr("Mute");
                        color: Theme.accent;
                        font-weight: 600;
                    }
                }

                // Composer: Enter sends, Shift+Enter starts a new line.
                Rectangle {
                    background: Theme.raised;
                    // Lined up with the message column above. Placed with x and
                    // width (not padding) so the window's minimum size does not
                    // depend on its own width.
                    property <length> side: max(12px, (self.width - Theme.column) / 2 + 16px);
                    // Hidden, not removed: functions above reach the composer.
                    visible: root.chat-can-post && !root.topics-open;
                    height: root.chat-can-post && !root.topics-open ? bar.preferred-height + self.strip : 0;
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: Theme.border;
                    }

                    // Reply or edit in progress: a strip above the input.
                    property <length> strip: root.bar-mode != "" ? 46px : 0;
                    if root.bar-mode != "": Rectangle {
                        x: parent.side;
                        y: 4px;
                        width: parent.width - 2 * parent.side;
                        height: 42px;
                        HorizontalLayout {
                            spacing: 10px;
                            padding-left: 4px;
                            VerticalLayout {
                                alignment: center;
                                StrokeIcon {
                                    tint: Theme.accent;
                                    commands: root.bar-mode == "edit" ? "M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4" : "M10 9V5l-7 7 7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z";
                                }
                            }

                            Rectangle {
                                width: 2px;
                                background: Theme.accent;
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.bar-title;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.bar-text;
                                    color: Theme.dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }

                            Rectangle {
                                width: 34px;
                                border-radius: 17px;
                                background: bar-x.has-hover ? Theme.hover : transparent;
                                bar-x := TouchArea {
                                    clicked => {
                                        root.bar-cancel();
                                    }
                                }
                                StrokeIcon {
                                    size: 18px;
                                    stroke-width: 2px;
                                    commands: "M6 6l12 12M18 6L6 18";
                                }
                            }
                        }
                    }

                    bar := HorizontalLayout {
                        x: parent.side;
                        y: parent.strip;
                        width: parent.width - 2 * parent.side;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: stretch;
                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: clip-touch.has-hover && root.bar-mode != "edit" ? Theme.hover : transparent;
                                opacity: root.bar-mode == "edit" ? 0.4 : 1;
                                clip-touch := TouchArea {
                                    enabled: root.bar-mode != "edit";
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.attach();
                                    }
                                }
                                Icon {
                                    x: 8px;
                                    y: 8px;
                                    size: 24px;
                                    commands: "M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5a2.5 2.5 0 0 0 5 0V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z";
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: max(40px, min(140px, composer.preferred-height + 20px));
                            border-radius: 20px;
                            background: Theme.input;
                            border-width: 1px;
                            border-color: composer.has-focus ? Theme.accent : transparent;
                            if composer.text == "": Text {
                                x: 14px;
                                y: 10px;
                                text: @tr("Message");
                                color: Theme.dim;
                            }
                            FocusScope {
                                x: 14px;
                                y: 10px;
                                width: parent.width - 28px;
                                height: parent.height - 20px;
                                capture-key-pressed(event) => {
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        root.send-text(composer.text);
                                        return accept;
                                    }
                                    reject
                                }
                                composer := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    single-line: false;
                                    wrap: word-wrap;
                                    color: Theme.text;
                                    selection-background-color: #4a7bb7;
                                    changed text => {
                                        root.composer-changed(self.text);
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                property <bool> ready: composer.text != "";
                                background: send-touch.has-hover && self.ready ? #74b3ee : Theme.accent;
                                opacity: self.ready ? 1 : 0.5;
                                send-touch := TouchArea {
                                    enabled: parent.ready;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.send-text(composer.text);
                                    }
                                }
                                Icon {
                                    x: 11px;
                                    size: 20px;
                                    tint: Theme.accent-text;
                                    commands: "M3 20.5v-7l10-1.5-10-1.5v-7L22 12 3 20.5z";
                                }
                            }
                        }
                    }
                }
            }

                // A forum: the chat body is the topic list.
                if root.topics-open: Rectangle {
                    y: 52px;
                    width: parent.width - (root.info-open && root.info-docked ? root.info-width : 0px);
                    height: parent.height - 52px;
                    background: Theme.chat-top;
                    clip: true;
                    TouchArea {
                        scroll-event(event) => {
                            accept
                        }
                    }
                    VerticalLayout {
                        padding-top: 6px;
                        for item[index] in root.topic-items: Rectangle {
                            height: 56px;
                            background: topic-touch.has-hover ? Theme.hover : transparent;
                            topic-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pick-topic(index);
                                }
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 34px;
                                        height: 34px;
                                        border-radius: 17px;
                                        background: item.color;
                                        Text {
                                            text: "#";
                                            color: Theme.accent-text;
                                            font-size: 15px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: item.title;
                                    color: Theme.text;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if item.unread > 0: Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Theme.accent;
                                    Text {
                                        text: "\{item.unread}";
                                        color: Theme.accent-text;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

            // ---- Profile column (like Telegram Web's chat info)
            if root.info-open && root.chat-open: Rectangle {
                x: parent.width - root.info-width;
                width: root.info-width;
                height: parent.height;
                background: Theme.raised;
                drop-shadow-blur: root.info-docked ? 0px : 20px;
                drop-shadow-color: #00000066;
                clip: true;
                // Clicks and the wheel stop here; the chat below must not get them.
                TouchArea {
                    scroll-event(event) => {
                        accept
                    }
                }
                Rectangle {
                    x: 0;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 14px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: info-close.has-hover ? Theme.hover : transparent;
                                info-close := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.info-open = false;
                                    }
                                }
                                StrokeIcon {
                                    size: 20px;
                                    x: 8px;
                                    y: 8px;
                                    stroke-width: 2px;
                                    commands: "M6 6l12 12M18 6L6 18";
                                }
                            }
                        }

                        Text {
                            text: @tr("Info");
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }
                }

                info-flick := Flickable {
                    y: 52px;
                    width: parent.width;
                    height: parent.height - 52px;
                    content-height: info-body.preferred-height;
                    interactive: false;
                    // The wheel scrolls by hand: the touch area under the content
                    // takes it wherever the content itself does not.
                    TouchArea {
                        width: parent.width;
                        height: max(parent.content-height, info-flick.height);
                        scroll-event(event) => {
                            info-flick.content-y = max(min(0px, info-flick.height - info-body.preferred-height), min(0px, info-flick.content-y + event.delta-y));
                            accept
                        }
                    }
                    info-body := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        Rectangle {
                            height: 212px;
                            Avatar {
                                x: (parent.width - self.width) / 2;
                                y: 22px;
                                size: 120px;
                                initial: root.info-initial;
                                tint: root.info-color;
                                photo: root.info-photo;
                                has-photo: root.info-has-photo;
                                saved: root.info-saved;
                            }

                            Text {
                                x: 20px;
                                y: 154px;
                                width: parent.width - 40px;
                                height: 26px;
                                text: root.info-title;
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                x: 20px;
                                y: 182px;
                                width: parent.width - 40px;
                                height: 20px;
                                text: root.info-subtitle;
                                color: Theme.dim;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if root.info-can-mute: Rectangle {
                            height: 48px;
                            background: info-mute.has-hover ? Theme.hover : transparent;
                            info-mute := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.toggle-mute();
                                }
                            }
                            StrokeIcon {
                                x: 20px;
                                y: 12px;
                                size: 24px;
                                stroke-width: 2px;
                                tint: Theme.dim;
                                commands: root.chat-muted ? "M18 8a6 6 0 0 0-9.3-5M6.3 6.3A6 6 0 0 0 6 8c0 7-3 9-3 9h14M10.3 21a2 2 0 0 0 3.4 0M3 3l18 18" : "M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M10.3 21a2 2 0 0 0 3.4 0";
                            }

                            Text {
                                x: 64px;
                                width: parent.width - 84px;
                                height: parent.height;
                                text: @tr("Notifications: {}", root.chat-muted ? @tr("Off") : @tr("On"));
                                color: Theme.text;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                        }

                        if root.info-error != "": Rectangle {
                            height: 44px;
                            Text {
                                x: 20px;
                                width: parent.width - 40px;
                                text: root.info-error;
                                color: Theme.danger;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if root.info-loading && root.info-error == "" && root.info-lines.length == 0: Rectangle {
                            height: 44px;
                            Text {
                                text: @tr("Loading…");
                                color: Theme.dim;
                                font-size: 14px;
                            }
                        }
                        if root.info-lines.length > 0: Rectangle {
                            height: 9px;
                            Rectangle {
                                y: 4px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                        for line in root.info-lines: ProfileRow {
                            line: line;
                        }
                        Rectangle {
                            height: 16px;
                        }
                    }
                }
            }
        }
    }

    clipboard := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }

    // ---- Burger menu
    if root.drawer-open: Rectangle {
        background: #00000073;
        TouchArea {
            clicked => {
                root.drawer-open = false;
            }
            scroll-event(event) => {
                accept
            }
        }
    }
    if root.drawer-open: Rectangle {
        x: 0;
        width: 280px;
        height: root.height;
        background: Theme.raised;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000066;
        TouchArea {
            scroll-event(event) => {
                accept
            }
        }
        VerticalLayout {
            VerticalLayout {
                // Only the spacer above the version takes the free height.
                vertical-stretch: 0;
                alignment: start;
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 20px;
                padding-bottom: 14px;
                spacing: 2px;
                Avatar {
                    size: 52px;
                    initial: root.me-initial;
                    tint: root.me-color;
                    photo: root.me-photo;
                    has-photo: root.me-has-photo;
                }

                Rectangle {
                    height: 8px;
                }

                Text {
                    text: root.me-name;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.me-phone != "": Text {
                    text: root.me-phone;
                    color: Theme.dim;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Rectangle {
                height: 6px;
            }

            DrawerItem {
                text: @tr("Saved Messages");
                clicked => {
                    root.drawer-open = false;
                    root.open-saved();
                }
            }

            DrawerItem {
                text: @tr("Contacts");
                clicked => {
                    root.drawer-open = false;
                    root.open-contacts();
                }
            }

            DrawerItem {
                text: @tr("Archive");
                clicked => {
                    root.drawer-open = false;
                    root.toggle-archive();
                }
            }

            DrawerItem {
                text: @tr("Refresh chats");
                clicked => {
                    root.drawer-open = false;
                    root.reload-dialogs();
                }
            }

            DrawerItem {
                text: @tr("Free up memory");
                clicked => {
                    root.drawer-open = false;
                    root.open-saver();
                }
            }

            DrawerItem {
                text: @tr("Settings");
                clicked => {
                    root.drawer-open = false;
                    root.open-settings();
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                padding-left: 18px;
                height: 40px;
                Text {
                    text: "Oxigram " + root.version;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- Settings: a column over the chat list, like Telegram Web
    if root.settings-open: SettingsPanel {
        open-url(url) => {
            root.open-link(url);
        }
        x: 0;
        y: 0;
        width: min(340px, root.width);
        height: root.height;
        page <=> root.settings-page;
        name: root.me-name;
        phone: root.me-phone;
        username: root.me-username;
        initial: root.me-initial;
        tint: root.me-color;
        photo: root.me-photo;
        has-photo: root.me-has-photo;
        options: root.saver-options;
        cache-text: root.cache-text;
        version: root.version;
        language-label: root.language-label;
        cycle-language => {
            root.cycle-language();
        }
        update-version: root.update-version;
        update-status: root.update-status;
        update-busy: root.update-busy;
        update-progress: root.update-progress;
        update-check => {
            root.update-check();
        }
        update-install => {
            root.update-install();
        }
        update-notes => {
            root.update-notes();
        }
        proxy-summary: root.proxy-summary;
        text-size: root.text-size-label;
        cycle-text-size => {
            root.cycle-text-size();
        }
        close => {
            root.settings-open = false;
        }
        toggle(key) => {
            root.saver-toggle(key);
        }
        clear-cache => {
            root.clear-cache();
        }
        sign-out => {
            root.ask-sign-out();
        }
        open-proxy => {
            root.open-proxy();
        }
        passcode-on: root.passcode-on;
        passcode-status: root.passcode-status;
        passcode-busy: root.passcode-busy;
        auto-lock-text: root.auto-lock-text;
        passcode-enable(a, b) => {
            root.passcode-enable(a, b);
        }
        passcode-change(a, b, c) => {
            root.passcode-change(a, b, c);
        }
        passcode-disable(a) => {
            root.passcode-disable(a);
        }
        cycle-auto-lock => {
            root.cycle-auto-lock();
        }
        lock-now => {
            root.lock-now();
        }
    }

    // ---- Contacts
    if root.contacts-open: ContactsWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        items: root.contacts-items;
        note: root.contacts-note;
        close => {
            root.contacts-open = false;
        }
        filter(text) => {
            root.contacts-filter(text);
        }
        pick(index) => {
            root.contacts-pick(index);
        }
        avatar(index) => {
            root.contacts-avatar(index);
        }
    }

    // ---- Proxy
    if root.proxy-open: Modal {
        width: root.width;
        height: root.height;
        title: @tr("Proxy");
        close => {
            root.proxy-open = false;
        }
        // Use the proxy: on/off
        Rectangle {
            height: 24px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.proxy-enabled = !root.proxy-enabled;
                }
            }
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: @tr("Use proxy");
                    color: Theme.text;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 34px;
                        height: 18px;
                        border-radius: 9px;
                        background: root.proxy-enabled ? Theme.accent : Theme.input;
                        Rectangle {
                            x: root.proxy-enabled ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.proxy-enabled ? white : Theme.dim;
                        }
                    }
                }
            }
        }

        // Telegram Web's WebSocket endpoints: no server or fields needed.
        Rectangle {
            height: 40px;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.proxy-kind == "websocket") {
                        root.proxy-kind = "socks5";
                    } else {
                        root.proxy-kind = "websocket";
                        root.proxy-enabled = true;
                    }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Bypass blocking (WebSocket)");
                        color: Theme.text;
                        font-size: 15px;
                    }
                    Text {
                        text: @tr("No server of your own: via Telegram Web");
                        color: Theme.dim;
                        font-size: 12px;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 34px;
                        height: 18px;
                        border-radius: 9px;
                        background: root.proxy-kind == "websocket" ? Theme.accent : Theme.input;
                        Rectangle {
                            x: root.proxy-kind == "websocket" ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.proxy-kind == "websocket" ? white : Theme.dim;
                        }
                    }
                }
            }
        }

        // Type: only SOCKS5 works yet; the others are shown as coming.
        if root.proxy-kind != "websocket": HorizontalLayout {
            spacing: 8px;
            for kind in [
                { id: "socks5", label: "SOCKS5", ready: true },
                { id: "http", label: "HTTP", ready: true },
                { id: "mtproto", label: @tr("MTProto · soon"), ready: false },
            ]: Rectangle {
                height: 32px;
                horizontal-stretch: 1;
                border-radius: 16px;
                border-width: 1px;
                border-color: root.proxy-kind == kind.id ? Theme.accent : Theme.border;
                background: root.proxy-kind == kind.id ? #2b527855 : transparent;
                opacity: kind.ready ? 1 : 0.45;
                TouchArea {
                    mouse-cursor: kind.ready ? pointer : default;
                    clicked => {
                        if (kind.ready) {
                            root.proxy-kind = kind.id;
                        }
                    }
                }
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: kind.label;
                    color: Theme.text;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if root.proxy-kind != "websocket": HorizontalLayout {
            spacing: 10px;
            Field {
                horizontal-stretch: 3;
                placeholder: @tr("Address, e.g. 127.0.0.1");
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-host;
            }

            Field {
                horizontal-stretch: 1;
                placeholder: @tr("Port");
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-port;
            }
        }

        if root.proxy-kind != "websocket": HorizontalLayout {
            spacing: 10px;
            Field {
                placeholder: @tr("Username (if required)");
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-user;
            }

            Field {
                placeholder: @tr("Password");
                password: true;
                enabled: root.proxy-enabled && !root.proxy-busy;
                text <=> root.proxy-pass;
            }
        }

        if root.proxy-status != "": Text {
            text: root.proxy-status;
            color: root.proxy-status-ok ? #6fd388 : Theme.danger;
            font-size: 13px;
            overflow: elide;
            height: 18px;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                kind: "ghost";
                text: @tr("Check");
                width: 120px;
                enabled: root.proxy-enabled && !root.proxy-busy;
                clicked => {
                    root.proxy-check();
                }
            }

            Button {
                kind: "ghost";
                text: @tr("Cancel");
                width: 110px;
                clicked => {
                    root.proxy-open = false;
                }
            }

            Button {
                text: @tr("Save");
                width: 120px;
                enabled: !root.proxy-busy;
                clicked => {
                    root.proxy-save();
                }
            }
        }
    }

    // ---- Forward picker
    if root.forward-open: Modal {
        width: root.width;
        height: root.height;
        title: @tr("Forward to…");
        close => {
            root.forward-open = false;
        }
        Rectangle {
            height: 34px;
            border-radius: 17px;
            background: Theme.input;
            if forward-search.text == "": Text {
                x: 14px;
                height: parent.height;
                text: @tr("Search");
                color: Theme.dim;
                vertical-alignment: center;
            }
            forward-search := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                init => {
                    self.focus();
                }
                edited => {
                    root.forward-filter(self.text);
                }
            }
        }

        ListView {
            height: min(360px, root.height - 220px);
            for item[index] in root.forward-items: DialogRow {
                item: item;
                clicked => {
                    root.forward-pick(index);
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                kind: "ghost";
                text: @tr("Cancel");
                width: 110px;
                clicked => {
                    root.forward-open = false;
                }
            }
        }
    }

    // ---- Confirmation
    if root.confirm-open: Modal {
        width: root.width;
        height: root.height;
        title: root.confirm-title;
        close => {
            root.confirm-done(false);
        }
        Text {
            text: root.confirm-text;
            color: Theme.dim;
            wrap: word-wrap;
        }

        if root.confirm-check != "": Rectangle {
            height: 24px;
            TouchArea {
                clicked => {
                    root.confirm-checked = !root.confirm-checked;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1.5px;
                        border-color: root.confirm-checked ? Theme.accent : Theme.dim;
                        background: root.confirm-checked ? Theme.accent : transparent;
                        if root.confirm-checked: Path {
                            width: 14px;
                            height: 14px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: Theme.accent-text;
                            stroke-width: 2.5px;
                            commands: "M5 12l5 5 9-10";
                        }
                    }
                }

                Text {
                    text: root.confirm-check;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                kind: "ghost";
                text: @tr("Cancel");
                width: 110px;
                clicked => {
                    root.confirm-done(false);
                }
            }

            DangerButton {
                text: root.confirm-ok;
                clicked => {
                    root.confirm-done(true);
                }
            }
        }
    }

    // ---- Send window (files from the clip, the clipboard or a drop)
    if root.send-open: Modal {
        width: root.width;
        height: root.height;
        title: root.send-count == 1 ? (root.send-single-picture && root.send-compress ? @tr("Send photo") : @tr("Send file")) : @tr("Send {}", root.send-count-text);
        close => {
            root.send-cancel();
        }
        // Fixed height: the list scrolls inside, the rest of the window never moves.
        ListView {
            height: min(root.send-items.length * 56px, 224px);
            for item[index] in root.send-items: Rectangle {
                height: 56px;
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Rectangle {
                        width: 48px;
                        border-radius: 8px;
                        background: Theme.input;
                        clip: true;
                        if item.has-thumb: Image {
                            source: item.thumb;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                        if !item.has-thumb: Icon {
                            x: 12px;
                            y: 12px;
                            size: 24px;
                            commands: "M6 2h8l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zm7 1.5V8h4.5L13 3.5z";
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        // One line each: no wrapped text to mis-measure.
                        Text {
                            text: item.name;
                            color: Theme.text;
                            font-size: 14px;
                            overflow: elide;
                            height: 20px;
                        }

                        Text {
                            text: item.size;
                            color: Theme.dim;
                            font-size: 12px;
                            height: 16px;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 32px;
                                border-radius: 16px;
                                background: remove-touch.has-hover ? Theme.hover : transparent;
                                remove-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.send-remove(index);
                                    }
                                }
                                StrokeIcon {
                                    size: 16px;
                                    stroke-width: 2px;
                                    commands: "M6 6l12 12M18 6L6 18";
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.send-has-pictures: Rectangle {
            height: 24px;
            TouchArea {
                clicked => {
                    root.send-compress = !root.send-compress;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1.5px;
                        border-color: root.send-compress ? Theme.accent : Theme.dim;
                        background: root.send-compress ? Theme.accent : transparent;
                        if root.send-compress: Path {
                            width: 14px;
                            height: 14px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            stroke: Theme.accent-text;
                            stroke-width: 2.5px;
                            commands: "M5 12l5 5 9-10";
                        }
                    }
                }

                Text {
                    text: root.send-count > 1 ? @tr("Compress images") : @tr("Compress image");
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 40px;
            border-radius: 20px;
            background: Theme.input;
            if caption-field.text == "": Text {
                x: 14px;
                height: parent.height;
                text: @tr("Caption");
                color: Theme.dim;
                vertical-alignment: center;
            }
            caption-field := TextInput {
                x: 14px;
                width: parent.width - 28px;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                selection-background-color: #4a7bb7;
                init => {
                    self.focus();
                }
                accepted => {
                    root.send-go(self.text, root.send-compress);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                kind: "ghost";
                text: @tr("Add");
                width: 104px;
                clicked => {
                    root.attach();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                kind: "ghost";
                text: @tr("Cancel");
                width: 90px;
                clicked => {
                    root.send-cancel();
                }
            }

            Button {
                text: @tr("Send");
                width: 110px;
                clicked => {
                    root.send-go(caption-field.text, root.send-compress);
                }
            }
        }
    }

    // ---- Upload progress with a cancel button
    if root.sending-active: Rectangle {
        width: min(360px, root.width - 32px);
        height: 52px;
        x: (root.width - self.width) / 2;
        y: root.height - 160px;
        border-radius: 12px;
        background: Theme.menu;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        Text {
            x: 14px;
            y: 8px;
            width: parent.width - 62px;
            height: 18px;
            text: root.sending-text;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }

        Rectangle {
            x: 14px;
            y: 34px;
            width: parent.width - 62px;
            height: 4px;
            border-radius: 2px;
            background: Theme.input;
            Rectangle {
                x: 0px;
                width: parent.width * max(0.02, min(1.0, root.sending-progress));
                border-radius: 2px;
                background: Theme.accent;
            }
        }

        Rectangle {
            x: parent.width - 44px;
            y: 8px;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: abort-touch.has-hover ? Theme.hover : transparent;
            abort-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.send-abort();
                }
            }
            StrokeIcon {
                size: 18px;
                stroke-width: 2px;
                commands: "M6 6l12 12M18 6L6 18";
            }
        }
    }

    // ---- Files dragged over the window
    if root.drop-hover: Rectangle {
        background: #0e1621cc;
        Rectangle {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            height: parent.height - 32px;
            border-radius: 16px;
            border-width: 2px;
            border-color: Theme.accent;
            Text {
                text: @tr("Drop files to send");
                color: Theme.text;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ---- Picture viewer
    if root.viewer-open: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000e6;
        TouchArea {
            clicked => {
                root.viewer-close();
            }
            pointer-event(event) => {
                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                    root.viewer-menu(self.mouse-x, self.mouse-y);
                }
            }
            scroll-event(event) => {
                accept
            }
        }
        if root.viewer-has-image: Image {
            // Exactly the size Rust decoded: 1:1 pixels, no rescaling.
            width: root.viewer-image-width;
            height: root.viewer-image-height;
            x: 28px + (parent.width - 56px - self.width) / 2;
            y: 56px + (parent.height - 140px - self.height) / 2;
            source: root.viewer-image;
            image-fit: contain;
        }
        // Video controls: play/pause, time, seek bar, sound.
        if root.viewer-video: Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - 60px;
            width: min(680px, parent.width - 56px);
            height: 44px;
            border-radius: 22px;
            background: #000000b3;
            TouchArea { }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 6px;
                    border-radius: 16px;
                    background: play-touch.has-hover ? #ffffff22 : transparent;
                    play-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.viewer-toggle-play();
                        }
                    }
                    Path {
                        x: 8px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: white;
                        commands: root.viewer-playing ? "M6 4h4v16H6zM14 4h4v16h-4z" : "M7 4l13 8-13 8z";
                    }
                }

                Text {
                    text: root.viewer-time;
                    color: white;
                    font-size: 13px;
                    vertical-alignment: center;
                    min-width: self.preferred-width;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    seek := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.viewer-seek(self.mouse-x / self.width);
                        }
                        moved => {
                            if (self.pressed) {
                                root.viewer-seek(self.mouse-x / self.width);
                            }
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: seek.has-hover ? 6px : 4px;
                        border-radius: 3px;
                        background: #ffffff40;
                    }
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: parent.width * root.viewer-progress;
                        height: seek.has-hover ? 6px : 4px;
                        border-radius: 3px;
                        background: white;
                    }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    y: 6px;
                    border-radius: 16px;
                    background: sound-touch.has-hover ? #ffffff22 : transparent;
                    sound-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.viewer-toggle-mute();
                        }
                    }
                    StrokeIcon {
                        x: 6px;
                        y: 6px;
                        tint: white;
                        commands: root.viewer-muted ? "M11 5 6 9H3v6h3l5 4V5zM16 9l5 6M21 9l-5 6" : "M11 5 6 9H3v6h3l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13";
                    }
                }
            }
        }
        if root.viewer-status != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: status-text.preferred-width + 28px;
            height: 34px;
            border-radius: 17px;
            background: #000000a0;
            status-text := Text {
                x: 14px;
                width: self.preferred-width;
                height: parent.height;
                text: root.viewer-status;
                color: white;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        if root.viewer-save-text != "": Rectangle {
            x: parent.width - 60px - self.width;
            y: 12px;
            width: save-text.preferred-width + 28px;
            height: 36px;
            border-radius: 18px;
            background: save-touch.has-hover ? #ffffff38 : #ffffff22;
            save-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.viewer-save();
                }
            }
            save-text := Text {
                x: 14px;
                width: self.preferred-width;
                height: parent.height;
                text: root.viewer-save-text;
                color: white;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: parent.width - 52px;
            y: 10px;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: close-touch.has-hover ? #ffffff38 : #ffffff22;
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.viewer-close();
                }
            }
            StrokeIcon {
                x: 10px;
                y: 10px;
                tint: white;
                stroke-width: 2px;
                commands: "M6 6l12 12M18 6L6 18";
            }
        }
    }

    // ---- Context menu
    if root.menu-open: TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.menu-open = false;
            }
        }
        scroll-event(event) => {
            root.menu-open = false;
            accept
        }
    }
    if root.menu-open: Rectangle {
        width: 220px;
        height: menu-column.preferred-height + 10px;
        x: max(4px, min(root.menu-x, root.width - self.width - 4px));
        y: max(4px, min(root.menu-y, root.height - self.height - 4px));
        background: Theme.menu;
        border-radius: 10px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000073;
        menu-column := VerticalLayout {
            padding: 5px;
            if root.menu-reactions.length > 0: HorizontalLayout {
                spacing: 1px;
                padding-bottom: 4px;
                for emoji in root.menu-reactions: Rectangle {
                    width: 29px;
                    height: 32px;
                    border-radius: 16px;
                    background: emoji == root.menu-reaction-mine ? #3a6ea5 : quick-touch.has-hover ? Theme.hover : transparent;
                    quick-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.menu-open = false;
                            root.menu-react(emoji);
                        }
                    }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: emoji;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            for entry in root.menu-items: Rectangle {
                height: entry.id == "-" ? 9px : 34px;
                if entry.id == "-": Rectangle {
                    y: 4px;
                    height: 1px;
                    background: Theme.hover;
                }
                if entry.id != "-": Rectangle {
                    border-radius: 6px;
                    background: item-touch.has-hover ? Theme.hover : transparent;
                    item-touch := TouchArea {
                        clicked => {
                            root.menu-open = false;
                            root.menu-pick(entry.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;
                        Path {
                            width: 18px;
                            height: 18px;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: entry.icon;
                            fill: transparent;
                            stroke: entry.danger ? Theme.danger : Theme.dim;
                            stroke-width: 1.8px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }

                        Text {
                            text: entry.label;
                            color: entry.danger ? Theme.danger : Theme.text;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // ---- Toast
    if root.toast != "": Rectangle {
        y: root.height - 90px;
        x: (root.width - self.width) / 2;
        width: toast-text.preferred-width + 28px;
        height: 34px;
        border-radius: 17px;
        background: Theme.menu;
        toast-text := Text {
            text: root.toast;
            color: Theme.text;
            font-size: 14px;
        }
    }
    }
}
